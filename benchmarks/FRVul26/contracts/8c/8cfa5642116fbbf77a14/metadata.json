    "devdoc": {
      "details": "This contract exists as a consequence of the gauge systems needing to know a fixed inflation schedule in order to know how much BAL a gauge is allowed to mint. As this does not exist within the BAL token itself it is defined here, we must then wrap the token's minting functionality in order for this to be meaningful.",
      "kind": "dev",
      "methods": {
        "activate()": {
          "details": "Reverts if contract does not have sole minting powers over BAL (and no other minters can be added)."
        },
