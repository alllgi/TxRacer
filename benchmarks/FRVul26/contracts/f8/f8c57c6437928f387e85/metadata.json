    "userdoc": {
      "kind": "user",
      "methods": {
        "claimBatchEarnings(address[],address)": {
          "notice": "Claims CRV, CVX and extra rewards from Convex for multiple Curve LP tokens staked."
        },
        "claimEarnings(address,address)": {
          "notice": "Claims CRV, CVX and extra rewards from Convex on behalf of a Conic pool."
        },
        "computeClaimableConvex(uint256)": {
          "notice": "Computes how much CVX can be claimed for an amount of CRV earned"
        },
        "deposit(address,uint256)": {
          "notice": "Deposits a Curve LP token on Convex and stakes the Convex Curve LP token in the respective CRV rewards contract on Convex."
        },
        "getCrvEarned(address,address)": {
          "notice": "Gets total amount of CRV earned by an account from staking an amount of Curve LP tokens via Convex for a single Curve pool."
        },
        "getCrvEarnedBatch(address,address[])": {
          "notice": "Gets total amount of CRV earned by an account from staking multiple Curve LP tokens via Convex."
        },
        "withdraw(address,uint256)": {
          "notice": "Withdraws Curve LP tokens from Convex."
        }
