          }
        },
        "batchUpdateFailedTx(uint256,uint256[],address[],uint256[])": {
          "params": {
            "amounts_": "are the amount of intermediary tokens that need to be refunded to the user",
            "indices_": "represents the failing indices in the payload",
            "interimTokens_": "is the list of intermediary tokens that cannot be swapped",
            "payloadId_": "represents the id of the payload"
          }
        },
        "constructor": {
          "params": {
