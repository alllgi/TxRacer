      "kind": "dev",
      "methods": {
        "disableModule(address)": {
          "details": "moduleAddr has to be one of the last 10 modules addedmodules are returned in order SM -> Mn -> M(n-1) -> ... -> M1 -> SM, without SM included",
          "params": {
            "_moduleAddr": "Address of module which will be removed from authority list"
          }
        },
        "enableModule(address)": {
          "details": "Can't enable the same module twice",
          "params": {
            "_moduleAddr": "Address of module which will be authorized"
          }
        },
        "executeAction(bytes,bytes32[],uint8[],bytes32[])": {
          "details": "Is called by the RecipeExecutor chaining actions together",
          "params": {
            "_callData": "Array of input values each value encoded as bytes",
            "_paramMapping": "Array that specifies how return and subscribed values are mapped in input",
            "_returnValues": "Returns values from actions before, which can be injected in inputs",
            "_subData": "Array of subscribed vales, replaces input values if specified"
          },
          "returns": {
            "_0": "Returns a bytes32 value through user wallet, each actions implements what that value is"
          }
        },
        "executeActionDirect(bytes)": {
          "details": "Used to save gas when executing a single action directly"
        },
        "giveProxyPermission(address)": {
          "params": {
            "_contractAddr": "Address which will be authorized"
          }
        },
        "giveWalletPermission(bool)": {
          "details": "Called from the context of the wallet we are using"
        },
        "kill()": {
          "details": "Deprecated method, selfdestruct will soon just send eth"
        },
        "removeProxyPermission(address)": {
          "params": {
            "_contractAddr": "Auth address which will be removed from authority list"
          }
        }
      },
      "version": 1
    },
