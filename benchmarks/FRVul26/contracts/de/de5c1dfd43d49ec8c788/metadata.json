          "returns": {
            "_0": "liquidityRate The liquidity rate expressed in rays",
            "_1": "stableBorrowRate The stable borrow rate expressed in rays",
            "_2": "variableBorrowRate The variable borrow rate expressed in rays"
          }
        },
        "constructor": {
