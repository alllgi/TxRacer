        },
        "getPrice(address,address)": {
          "params": {
            "baseToken": "The address of the token for which the price is requested.",
            "quoteToken": "The address of the token in which the price is quoted."
          },
          "returns": {
            "_0": "price The price of baseToken denominated in quoteToken (expressed in quoteToken decimals)."
          }
        },
        "isConsumingScheduledOp()": {
          "details": "Returns true only in the context of a delayed restricted call, at the moment that the scheduled operation is being consumed. Prevents denial of service for delayed restricted calls in the case that the contract performs attacker controlled calls."
        },
        "setAuthority(address)": {
          "details": "Transfers control to a new authority. The caller must be the current authority."
        },
        "setFeedRoute(address,address,uint256,address,uint256)": {
          "details": "Both feeds, if set, must be Chainlink-interface-compliant. The combination of feed1 and feed2 must be able to price the token in the reference currency. If feed2 is set to address(0), the token price in the reference currency is assumed to be returned by feed1.",
          "params": {
            "feed1": "The address of the first price feed.",
            "feed2": "The address of the second price feed. Can be set to address(0).",
            "stalenessThreshold1": "The staleness threshold for the first price feed.",
            "stalenessThreshold2": "The staleness threshold for the second price feed. Ignored if feed2 is address(0).",
            "token": "The address of the token for which the price feed route is set."
          }
        },
        "setFeedStaleThreshold(address,uint256)": {
          "params": {
            "feed": "The address of the price feed.",
            "threshold": "The value of staleness threshold."
          }
        }
      },
