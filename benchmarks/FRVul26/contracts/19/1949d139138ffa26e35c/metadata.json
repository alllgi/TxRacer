      "methods": {
        "canUpgrade()": {
          "notice": "Child contract can enable to provide the condition when the upgrade can begun.\r"
        },
        "getUpgradeState()": {
          "notice": "Get the state of the token upgrade.\r"
        },
        "setTokenInformation(string,string)": {
          "notice": "Owner can update token information here.\r    * It is often useful to conceal the actual token association, until\r the token operations, like central issuance or reissuance have been completed.\r In this case the initial token can be supplied with empty name and symbol information.\r    * This function allows the token owner to rename the token after the operations\r have been completed and then point the audience to use the token contract.\r"
        },
        "setUpgradeAgent(address)": {
          "notice": "Set an upgrade agent that handles\r"
        },
        "setUpgradeMaster(address)": {
          "notice": "Change the upgrade master.\r    * This allows us to set a new owner for the upgrade mechanism.\r"
        },
        "upgrade(uint256)": {
          "notice": "Allow the token holder to upgrade some of their tokens to a new contract.\r"
        }
      },
      "notice": "Centrally issued Ethereum token. The SHx issued here are 'cross-issued' from Stellar.\r (GDSTRSHXHGJ7ZIVRBXEYE5Q74XUVCUSEKEBR7UCHEUUEK72N7I7KJ6JH:SHX)\r  * We mix in burnable and upgradeable traits.\r  * Token supply is created in the token contract creation and allocated to owner.\r The owner can then transfer from its supply to crowdsale participants.\r The owner, or anybody, can burn any excessive tokens they are holding.\r  "
    }
