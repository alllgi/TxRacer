    "devdoc": {
      "kind": "dev",
      "methods": {
        "claimFees(address)": {
          "details": "This function must be called by the BoringVault.This function will lose precision if the exchange rate      decimals is greater than the feeAsset's decimals."
        },
        "getRateInQuote(address)": {
          "details": "`quote` must have its RateProviderData set, else this will revert.This function will lose precision if the exchange rate      decimals is greater than the quote's decimals."
        },
        "getRateInQuoteSafe(address)": {
          "details": "`quote` must have its RateProviderData set, else this will revert.Revert if paused."
        },
        "getRateSafe()": {
          "details": "Revert if paused."
        },
        "pause()": {
          "details": "Callable by MULTISIG_ROLE."
        },
        "resetHighwaterMark()": {
          "details": "Callable by OWNER_ROLE."
        },
        "setRateProviderData(address,bool,address)": {
          "details": "Rate providers must return rates in terms of `base` or an asset pegged to base and they must use the same decimals as `asset`.Callable by OWNER_ROLE."
        },
        "unpause()": {
          "details": "Callable by MULTISIG_ROLE."
        },
        "updateDelay(uint24)": {
          "details": "There are no input requirements, as it is possible the admin would want      the exchange rate updated as frequently as needed.Callable by OWNER_ROLE."
        },
        "updateExchangeRate(uint96)": {
          "details": "If new exchange rate is outside of accepted bounds, or if not enough time has passed, this      will pause the contract, and this function will NOT calculate fees owed.Callable by UPDATE_EXCHANGE_RATE_ROLE."
        },
        "updateLower(uint16)": {
          "details": "Callable by OWNER_ROLE."
        },
        "updateManagementFee(uint16)": {
          "details": "Callable by OWNER_ROLE."
        },
        "updatePayoutAddress(address)": {
          "details": "Callable by OWNER_ROLE."
        },
        "updatePerformanceFee(uint16)": {
          "details": "Callable by OWNER_ROLE."
        },
        "updateUpper(uint16)": {
          "details": "Callable by OWNER_ROLE."
        }
