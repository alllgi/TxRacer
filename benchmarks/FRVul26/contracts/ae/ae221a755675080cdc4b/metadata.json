          "notice": "Get this BoringVault's current rate in the base."
        },
        "pause()": {
          "notice": "Pause this contract, which prevents future calls to `updateExchangeRate`, and any safe rate         calls will revert."
        },
        "rateProviderData(address)": {
          "notice": "Maps ERC20s to their RateProviderData."
        },
        "resetHighwaterMark()": {
          "notice": "Reset the highwater mark to the current exchange rate."
        },
        "setRateProviderData(address,bool,address)": {
          "notice": "Update the rate provider data for a specific `asset`."
        },
        "unpause()": {
          "notice": "Unpause this contract, which allows future calls to `updateExchangeRate`, and any safe rate         calls will stop reverting."
        },
        "updateDelay(uint24)": {
          "notice": "Update the minimum time delay between `updateExchangeRate` calls."
        },
        "updateExchangeRate(uint96)": {
          "notice": "Updates this contract exchangeRate."
        },
        "updateLower(uint16)": {
          "notice": "Update the allowed lower bound change of exchange rate between `updateExchangeRateCalls`."
        },
        "updateManagementFee(uint16)": {
          "notice": "Update the management fee to a new value."
        },
        "updatePayoutAddress(address)": {
          "notice": "Update the payout address fees are sent to."
        },
        "updatePerformanceFee(uint16)": {
          "notice": "Update the performance fee to a new value."
        },
        "updateUpper(uint16)": {
          "notice": "Update the allowed upper bound change of exchange rate between `updateExchangeRateCalls`."
        },
        "vault()": {
          "notice": "The BoringVault this accountant is working with.         Used to determine share supply for fee calculation."
        }
