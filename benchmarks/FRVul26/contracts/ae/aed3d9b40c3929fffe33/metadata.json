            "totalSyInterestForTreasury": "current amount of SY interests post-expiry for treasury",
            "userRewardOwed": "amount of unclaimed user rewards, for each reward token"
          }
        },
        "mintPY(address,address)": {
          "details": "SY must be transferred to this contract prior to calling"
        },
        "name()": {
          "details": "Returns the name of the token."
        },
        "nonces(address)": {
          "details": "See {IERC20Permit-nonces}."
        },
        "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)": {
          "details": "See {IERC20Permit-permit}."
        },
        "pyIndexCurrent()": {
          "details": "this function maximizes the current PY index with the previous index, guaranteeing non-decreasing PY indexif `doCacheIndexSameBlock` is true, PY index only updates at most once per block, and has no state changes on the second call onwards (within the same block).see `pyIndexStored()` for view function for cached value."
        },
        "redeemDueInterestAndRewards(address,bool,bool)": {
          "details": "With YT yielding interest in the form of SY, which is redeemable by users, the reward distribution should be based on the amount of SYs that their YT currently represent, plus their dueInterest. It has been proven and tested that _rewardSharesUser will not change over time, unless users redeem their dueInterest or redeemPY. Due to this, it is required to update users' accruedReward STRICTLY BEFORE transferring out their interest.",
          "params": {
            "redeemInterest": "will only transfer out interest for user if true",
            "redeemRewards": "will only transfer out rewards for user if true"
          }
        },
        "redeemInterestAndRewardsPostExpiryForTreasury()": {
          "details": "All rewards and interests accrued post-expiry goes to the treasury. Reverts if called pre-expiry."
        },
        "redeemPY(address)": {
          "details": "PT/YT must be transferred to this contract prior to calling"
        },
        "redeemPYMulti(address[],uint256[])": {
          "details": "PT/YT must be transferred to this contract prior to callingfails if unable to redeem the total PY amount in `amountPYToRedeems`"
        },
        "setPostExpiryData()": {
          "details": "has no effect if called pre-expiry"
        },
        "symbol()": {
          "details": "Returns the symbol of the token, usually a shorter version of the name."
        },
        "totalSupply()": {
          "details": "See {IERC20-totalSupply}."
        },
        "transfer(address,uint256)": {
          "details": "See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `amount`."
        },
        "transferFrom(address,address,uint256)": {
          "details": "See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `amount`. - the caller must have allowance for ``from``'s tokens of at least `amount`."
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "getPostExpiryData()": {
          "notice": "returns the current data post-expiry, if exists"
        },
        "mintPY(address,address)": {
          "notice": "Tokenize SY into PT + YT of equal qty. Every unit of asset of SY will create 1 PT + 1 YT"
        },
        "mintPYMulti(address[],address[],uint256[])": {
          "notice": "Tokenize SY into PT + YT for multiple receivers. See `mintPY()` for more details"
        },
        "pyIndexCurrent()": {
          "notice": "updates and returns the current PY index"
        },
        "pyIndexStored()": {
          "notice": "returns the last-updated PY index"
        },
        "redeemDueInterestAndRewards(address,bool,bool)": {
          "notice": "Redeems interests and rewards for `user`"
        },
        "redeemPY(address)": {
          "notice": "converts PT(+YT) tokens into SY, but interests & rewards are not redeemed at the same time"
        },
        "redeemPYMulti(address[],uint256[])": {
          "notice": "redeems PT(+YT) for multiple users. See `redeemPY()`"
        },
        "rewardIndexesCurrent()": {
          "notice": "updates and returns the reward indexes"
        },
        "setPostExpiryData()": {
          "notice": "do a final rewards redeeming, and sets post-expiry data"
        }
      },
      "notice": "Invariance to maintain: - address(0) & address(this) should never have any rewards & activeBalance accounting done. This is guaranteed by address(0) & address(this) check in each updateForTwo function",
      "version": 1
    }
