      "methods": {
        "dayGap(uint32,uint256)": {
          "details": "Subtracts the start time from the end time and divides by the seconds per day.",
          "params": {
            "end": "The ending timestamp.",
            "start": "The starting timestamp."
          },
          "returns": {
            "daysPassed": "The number of full days between the two timestamps."
          }
        },
        "getDayEnd(uint32)": {
          "details": "Adjusts the provided timestamp by subtracting the turnover time, calculates the next day's timestamp at 2 PM UTC.",
          "params": {
            "t": "The starting timestamp."
          },
          "returns": {
            "nextDayStartAt2PM": "The timestamp for the next day ending at 2 PM UTC."
          }
        }
      },
