      "methods": {
        "bal(address)": {
          "returns": {
            "_0": "{tok} The balance of the ERC20 in whole tokens"
          }
        },
        "claimRewards()": {
          "custom:delegate-call": ""
        },
        "constructor": {
          "params": {
            "config": ".chainlinkFeed Feed units: {UoA/ref}"
          }
        },
        "isCollateral()": {
          "returns": {
            "_0": "If the asset is an instance of ICollateral or not"
          }
        },
        "lotPrice()": {
          "details": "Deprecated. Phased out in 3.1.0, but left on interface for backwards compatibility",
          "returns": {
            "lotHigh": "{UoA/tok} The upper end of the lot price estimate",
            "lotLow": "{UoA/tok} The lower end of the lot price estimate"
          }
        },
        "price()": {
          "details": "Should be general enough to not need to be overridden",
          "returns": {
            "_high": "{UoA/tok} The upper end of the price estimate",
            "_low": "{UoA/tok} The lower end of the price estimate"
          }
        },
        "refPerTok()": {
          "returns": {
            "_0": "{ref/tok} Quantity of whole reference units per whole collateral tokens"
          }
        },
        "refresh()": {
          "details": "May need to override: limited to handling collateral with refPerTok() = 1"
        },
        "status()": {
          "returns": {
            "_0": "The collateral's status"
          }
        },
        "targetPerRef()": {
          "returns": {
            "_0": "{target/ref} Quantity of whole target units per whole reference unit in the peg"
          }
        },
        "tryPrice()": {
          "details": "Override this when pricing is more complicated than just a single oracle",
          "returns": {
            "high": "{UoA/tok} The high price estimate",
            "low": "{UoA/tok} The low price estimate",
            "pegPrice": "{target/ref} The actual price observed in the peg"
          }
        }
      },
      "stateVariables": {
        "targetName": {
          "return": "The canonical name of this collateral's target unit.",
          "returns": {
            "_0": "The canonical name of this collateral's target unit."
          }
        }
      },
      "title": "FiatCollateral Parent class for all collateral. Can be extended to support appreciating collateral For: {tok} == {ref}, {ref} != {target}, {target} == {UoA} Can be easily extended by (optionally) re-implementing:   - tryPrice()   - refPerTok()   - targetPerRef()   - claimRewards() If you have appreciating collateral, then you should use AppreciatingFiatCollateral or override refresh() yourself. Can intentionally disable default checks by setting config.defaultThreshold to 0",
      "version": 1
    },
    "userdoc": {
      "errors": {
        "UIntOutOfBounds()": [
          {
            "notice": "The logical type `uint192 ` is a 192 bit value, representing an 18-decimal Fixed-point fractional value.  This is what's described in the Solidity documentation as \"fixed192x18\" -- a value represented by 192 bits, that makes 18 digits available to the right of the decimal point. The range of values that uint192 can represent is about [-1.7e20, 1.7e20]. Unless a function explicitly says otherwise, it will fail on overflow. To be clear, the following should hold: toFix(0) == 0 toFix(1) == 1e18"
          }
        ]
      },
      "events": {
        "CollateralStatusChanged(uint8,uint8)": {
          "notice": "Emitted whenever the collateral status is changed"
        },
        "RewardsClaimed(address,uint256)": {
          "notice": "Emitted whenever a reward token balance is claimed"
        }
      },
      "kind": "user",
      "methods": {
        "claimRewards()": {
          "notice": "Claim rewards earned by holding a balance of the ERC20 token"
        },
        "lotPrice()": {
          "notice": "Should not revert lotLow should be nonzero when the asset might be worth selling"
        },
        "price()": {
          "notice": "Should not revert low should be nonzero if the asset could be worth sellingIf the price feed is broken, _low will decay downwards and _high will decay upwards     If tryPrice() is broken for `oracleTimeout + priceTimeout + ORACLE_TIMEOUT_BUFFER` ,     _low will be 0 and _high will be FIX_MAX.     Because the price decay begins at `oracleTimeout + ORACLE_TIMEOUT_BUFFER` seconds,     the price feed can be broken for up to `2 * oracleTimeout` seconds without     affecting the price estimate.  This could happen if the Asset is refreshed just before     the maxOracleTimeout is reached, forcing a second period to pass before     the price begins to decay."
        },
        "refresh()": {
          "notice": "Should not revert Refresh exchange rates and update default status."
        },
        "tryPrice()": {
          "notice": "Can revert, used by other contract functions in order to catch errors Should not return FIX_MAX for low Should only return FIX_MAX for high if low is 0"
        }
      },
      "version": 1
    }
