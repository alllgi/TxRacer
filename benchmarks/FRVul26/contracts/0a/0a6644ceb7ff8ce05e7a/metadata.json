        "AdminChanged(address,address)": {
          "details": "Emitted when the admin account has changed."
        },
        "BackupConfigSet(bytes32,uint256,address[])": {
          "params": {
            "erc20s": "The set of backup collateral tokens",
            "max": "The max number to use from `erc20s`",
            "targetName": "The name of the target unit as a bytes32"
          }
        },
        "BasketSet(uint256,address[],uint192[],bool)": {
          "params": {
            "disabled": "True when the list of erc20s + refAmts may not be correct",
            "erc20s": "The list of collateral tokens in the reference basket",
            "nonce": "{basketNonce} The basket nonce",
            "refAmts": "{ref/BU} The reference amounts of the basket collateral tokens"
          }
        },
        "BasketStatusChanged(uint8,uint8)": {
          "params": {
            "newStatus": "The new basket status",
            "oldStatus": "The previous basket status"
          }
        },
        "BeaconUpgraded(address)": {
          "details": "Emitted when the beacon is changed."
        },
        "Initialized(uint8)": {
          "details": "Triggered when the contract has been initialized or reinitialized."
        },
        "LastCollateralizedChanged(uint48,uint48)": {
          "params": {
            "newVal": "The new value of lastCollateralized",
            "oldVal": "The old value of lastCollateralized"
          }
        },
        "PrimeBasketSet(address[],uint192[],bytes32[])": {
          "params": {
            "erc20s": "The collateral tokens for the prime basket",
            "targetAmts": "{target/BU} A list of quantities of target unit per basket unit",
            "targetNames": "Each collateral token's targetName"
          }
        },
        "Upgraded(address)": {
          "details": "Emitted when the implementation is upgraded."
        },
        "WarmupPeriodSet(uint48,uint48)": {
          "params": {
            "newVal": "The new warmup period",
            "oldVal": "The old warmup period"
          }
        }
      },
      "kind": "dev",
      "methods": {
        "basketsHeldBy(address)": {
          "details": "Returns (FIX_ZERO, FIX_MAX) for an empty or DISABLED basket",
          "returns": {
            "baskets": "{BU}          .top The number of partial basket units: e.g max(coll.map((c) => c.balAsBUs())          .bottom The number of whole basket units held by the account"
          }
        },
        "disableBasket()": {
          "custom:protected": ""
        },
        "forceSetPrimeBasket(address[],uint192[])": {
          "custom:governance": "",
          "params": {
            "erc20s": "The collateral for the new prime basket",
            "targetAmts": "The target amounts (in) {target/BU} for the new prime basket"
          }
        },
        "fullyCollateralized()": {
          "returns": {
            "_0": "Whether this contract owns enough collateral to cover rToken.basketsNeeded() BUs ie, whether the protocol is currently fully collateralized"
          }
        },
        "getBackupConfig(bytes32)": {
          "params": {
            "targetName": "The name of the target unit to lookup the backup for"
          },
          "returns": {
            "erc20s": "The backup erc20s for the target unit, in order of most to least desirable",
            "max": "The maximum number of tokens from the array to use at a single time"
          }
        },
        "getHistoricalBasket(uint48)": {
          "params": {
            "basketNonce": "{basketNonce}"
          },
          "returns": {
            "erc20s": "The erc20s in the reference basket",
            "quantities": "{qTok/BU} The quantity of whole tokens per whole basket unit"
          }
        },
        "getPrimeBasket()": {
          "details": "Indices are shared across return values",
          "returns": {
            "erc20s": "The erc20s in the prime basket",
            "targetAmts": "{target/BU} The amount of the target unit in the basket, per ERC20",
            "targetNames": "The bytes32 name identifier of the target unit, per ERC20"
          }
        },
        "isReady()": {
          "returns": {
            "_0": "Whether the basket is ready to issue and trade"
          }
        },
        "lotPrice()": {
          "details": "Deprecated. Phased out in 3.1.0, but left on interface for backwards compatibility",
          "returns": {
            "lotHigh": "{UoA/BU} The upper end of the lot price estimate",
            "lotLow": "{UoA/BU} The lower end of the lot price estimate"
          }
        },
        "price()": {
          "returns": {
            "high": "{UoA/BU} The upper end of the price estimate",
            "low": "{UoA/BU} The lower end of the price estimate"
          }
        },
        "proxiableUUID()": {
          "details": "Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."
        },
        "quantity(address)": {
          "params": {
            "erc20": "The token contract to check for quantity for"
          },
          "returns": {
            "_0": "{tok/BU} The token-quantity of an ERC20 token in the basket."
          }
        },
        "quantityUnsafe(address,address)": {
          "params": {
            "asset": "The registered asset plugin contract for the erc20",
            "erc20": "The ERC20 token contract for the asset"
          },
          "returns": {
            "_0": "{tok/BU} The token-quantity of an ERC20 token in the basket."
          }
        },
        "quote(uint192,uint8)": {
          "details": "Subset of logic of quoteCustomRedemption; more gas efficient for current nonce",
          "params": {
            "amount": "{BU}"
          },
          "returns": {
            "erc20s": "The backing collateral erc20s",
            "quantities": "{qTok} ERC20 token quantities equal to `amount` BUs"
          }
        },
        "quoteCustomRedemption(uint48[],uint192[],uint192)": {
          "params": {
            "amount": "{BU}",
            "basketNonces": "An array of basket nonces to do redemption from",
            "portions": "{1} An array of Fix quantities"
          },
          "returns": {
            "erc20s": "The backing collateral erc20s",
            "quantities": "{qTok} ERC20 token quantities equal to `amount` BUs"
          }
        },
        "refreshBasket()": {
          "custom:interaction": "OR @custom:governance"
        },
        "setBackupConfig(bytes32,uint256,address[])": {
          "custom:governance": ""
        },
        "setPrimeBasket(address[],uint192[])": {
          "custom:governance": "",
          "params": {
            "erc20s": "The collateral for the new prime basket",
            "targetAmts": "The target amounts (in) {target/BU} for the new prime basket"
          }
        },
        "setWarmupPeriod(uint48)": {
          "custom:governance": ""
        },
        "status()": {
          "returns": {
            "status_": "The status of the basket"
          }
        },
        "trackStatus()": {
          "custom:refresher": ""
