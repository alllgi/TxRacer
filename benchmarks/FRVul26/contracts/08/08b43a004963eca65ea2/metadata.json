    "devdoc": {
      "kind": "dev",
      "methods": {
        "activateSub(uint256)": {
          "details": "Must own the sub. to be able to enable it",
          "params": {
            "_subId": "Id of subscription to enable"
          }
        },
        "deactivateSub(uint256)": {
          "details": "Must own the sub. to be able to disable it",
          "params": {
            "_subId": "Id of subscription to disable"
          }
        },
        "subscribeToStrategy((uint64,bool,bytes[],bytes32[]))": {
          "details": "To save on gas we don't store the whole struct but rather the hash of the struct",
          "params": {
            "_sub": "Subscription struct of the user (is not stored on chain, only the hash)"
          }
        },
        "updateSubData(uint256,(uint64,bool,bytes[],bytes32[]))": {
          "details": "Only callable by proxy who created the sub.",
          "params": {
            "_sub": "Subscription struct of the user (needs whole struct so we can hash it)",
            "_subId": "Id of the subscription to update"
          }
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "activateSub(uint256)": {
          "notice": "Enables the subscription for execution if disabled"
        },
        "deactivateSub(uint256)": {
          "notice": "Disables the subscription (will not be able to execute the strategy for the user)"
        },
        "kill()": {
          "notice": "Destroy the contract"
        },
        "subscribeToStrategy((uint64,bool,bytes[],bytes32[]))": {
          "notice": "Adds users info and records StoredSubData, logs StrategySub"
        },
        "updateSubData(uint256,(uint64,bool,bytes[],bytes32[]))": {
          "notice": "Updates the users subscription data"
        },
        "withdrawStuckFunds(address,address,uint256)": {
          "notice": "withdraw stuck funds"
        }
      },
