      "methods": {
        "ADMIN_ROLE()": {
          "notice": "The role assigned to users who can call admin/restricted functions"
        },
        "MINT_MAX_PERCENT()": {
          "notice": "Cap on the percentage of the total supply that can be minted at each mint. Denominated in percentage points (units out of 100000 for division precision). This value is set to the number e or Euler's number = 2.71828 (%)"
        },
        "MINT_MIN_INTERVAL()": {
          "notice": "Minimum time between mints."
        },
        "constructor": {
          "notice": "Constructor."
        },
        "mint()": {
          "notice": "Mint new tokens only after the required time period has elapsed. It will mint to the treasury address set by owner"
        },
        "mintingRestrictedBefore()": {
          "notice": "The timestamp on and after which minting may occur."
        },
        "treasury()": {
          "notice": "The recipient of the minted tokens"
        },
        "updateTreasury(address)": {
          "notice": "Update the treasury address to receive minted tokens.  Only callable by admins."
        }
      },
