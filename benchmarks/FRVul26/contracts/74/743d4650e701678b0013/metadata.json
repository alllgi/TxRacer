    "devdoc": {
      "details": "This contract is used as a router for both on-ramps and off-ramps",
      "kind": "dev",
      "methods": {
        "ccipSend(uint64,(bytes,bytes,(address,uint256)[],address,bytes))": {
          "details": "Note if msg.value is larger than the required fee (from getFee) we accept the overpayment with no refund.Reverts with appropriate reason upon invalid message.",
          "params": {
            "destinationChainSelector": "The destination chain ID",
            "message": "The cross-chain CCIP message including data and/or tokens"
          },
          "returns": {
            "_0": "messageId The message ID"
          }
        },
        "getArmProxy()": {
          "returns": {
            "_0": "The address of the ARM proxy contract."
          }
        },
        "getFee(uint64,(bytes,bytes,(address,uint256)[],address,bytes))": {
          "details": "Reverts with appropriate reason upon invalid message.",
          "params": {
            "destinationChainSelector": "The destination chainSelector",
            "message": "The cross-chain CCIP message including data and/or tokens"
          },
          "returns": {
            "fee": "returns execution fee for the message delivery to destination chain, denominated in the feeToken specified in the message."
          }
        },
        "getOnRamp(uint64)": {
          "params": {
            "destChainSelector": "The destination chain Id to get the onRamp for."
          },
          "returns": {
            "_0": "The address of the onRamp."
          }
        },
        "getSupportedTokens(uint64)": {
          "params": {
            "chainSelector": "The chainSelector."
          },
          "returns": {
            "_0": "The addresses of all tokens that are supported."
          }
        },
        "getWrappedNative()": {
          "returns": {
            "_0": "The address of the ERC20 wrapped native."
          }
        },
        "isChainSupported(uint64)": {
          "params": {
            "chainSelector": "The chain to check."
          },
          "returns": {
            "_0": "is true if it is supported, false if not."
          }
        },
        "recoverTokens(address,address,uint256)": {
          "details": "Must be onlyOwner to avoid malicious token contract calls.",
          "params": {
            "to": "Destination address to send the tokens to.",
            "tokenAddress": "ERC20-token to recover"
          }
        },
        "routeMessage((bytes32,uint64,bytes,bytes,(address,uint256)[]),uint16,uint256,address)": {
          "details": "_callWithExactGas protects against return data bombs by capping the return data size at MAX_RET_BYTES.",
          "params": {
            "gasForCallExactCheck": "of params for exec",
            "gasLimit": "set of params for exec",
            "message": "Client.Any2EVMMessage struct.",
            "receiver": "set of params for exec"
          },
          "returns": {
            "gasUsed": "the gas used by the external customer call. Does not include any overhead.",
            "retData": "A bytes array containing return data form CCIP receiver.",
            "success": "A boolean value indicating whether the ccip message was received without errors."
          }
        },
        "setWrappedNative(address)": {
          "params": {
            "wrappedNative": "The address of the new wrapped native ERC20 token."
          }
        }
      },
      "title": "Router",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "acceptOwnership()": {
          "notice": "Allows an ownership transfer to be completed by the recipient."
        },
        "applyRampUpdates((uint64,address)[],(uint64,address)[],(uint64,address)[])": {
          "notice": "applyRampUpdates applies a set of ramp changes which provides the ability to add new chains and upgrade ramps."
        },
        "ccipSend(uint64,(bytes,bytes,(address,uint256)[],address,bytes))": {
          "notice": "Request a message to be sent to the destination chain"
        },
        "getArmProxy()": {
          "notice": "Gets the arm address"
        },
        "getOnRamp(uint64)": {
          "notice": "Return the configured onramp for specific a destination chain."
        },
        "getSupportedTokens(uint64)": {
          "notice": "Gets a list of all supported tokens which can be sent or received to/from a given chain id."
        },
        "getWrappedNative()": {
          "notice": "Gets the wrapped representation of the native fee coin."
        },
        "isChainSupported(uint64)": {
          "notice": "Checks if the given chain ID is supported for sending/receiving."
        },
        "owner()": {
          "notice": "Get the current owner"
        },
        "recoverTokens(address,address,uint256)": {
          "notice": "Provides the ability for the owner to recover any tokens accidentally sent to this contract."
        },
        "routeMessage((bytes32,uint64,bytes,bytes,(address,uint256)[]),uint16,uint256,address)": {
          "notice": "Route the message to its intended receiver contract."
        },
        "setWrappedNative(address)": {
          "notice": "Sets a new wrapped native token."
        },
        "transferOwnership(address)": {
          "notice": "Allows an owner to begin transferring ownership to a new address."
        }
      },
      "notice": "This is the entry point for the end user wishing to send data across chains.",
      "version": 1
    }
