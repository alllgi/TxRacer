    "devdoc": {
      "author": "ConvexFinance",
      "kind": "dev",
      "methods": {
        "claimCrv(address)": {
          "details": "Claim CRV for LP token staking from the CRV minter contract"
        },
        "claimFees(address,address)": {
          "details": "Only callable by the operator Booster",
          "params": {
            "_distroContract": "Fee distribution contract",
            "_token": "LP token to claim fees for"
          }
        },
        "claimRewards(address)": {
          "details": "Called by operator (Booster) to claim extra rewards "
        },
        "constructor": {
          "params": {
            "_crv": "CRV Token address",
            "_crvBpt": "CRV:ETH 80-20 BPT Token address",
            "_escrow": "Curve Voting escrow contract",
            "_gaugeController": "Curve Gauge Controller                          Controls liquidity gauges and the issuance of coins through the gauges",
            "_mintr": "CRV minter"
          }
        },
        "createLock(uint256,uint256)": {
          "details": "Called by the CrvDepositor contract",
          "params": {
            "_unlockTime": "Timestamp to unlock (max is 4 years)",
            "_value": "Amount of crv to lock"
          }
        },
        "deposit(address,address)": {
          "details": "Only can be called by the operator (Booster) once this contract has been          whitelisted by the Curve DAO",
          "params": {
            "_gauge": "Gauge contract to deposit to ",
            "_token": "Deposit LP token address"
          }
        },
        "increaseTime(uint256)": {
          "params": {
            "_value": "Timestamp to increase locking to"
          }
        },
        "isValidSignature(bytes32,bytes)": {
          "details": "Snapshot Hub will call this function when a vote is submitted using          snapshot.js on behalf of this contract. Snapshot Hub will call this          function with the hash and the signature of the vote that was cast.",
          "params": {
            "_hash": "Hash of the message that was sent to Snapshot Hub to cast a vote"
          },
          "returns": {
            "_0": "EIP1271 magic value if the signature is value "
          }
        },
        "release()": {
          "details": "Only callable by CrvDepositor and can only withdraw if lock has expired"
        },
        "setDepositor(address)": {
          "params": {
            "_depositor": "Address of the depositor (CrvDepositor)"
          }
        },
        "setOperator(address)": {
          "params": {
            "_operator": "Address of the operator (Booster)"
          }
        },
        "setRewardDeposit(address,address)": {
          "params": {
            "_rewardDeposit": "Distributor address",
            "_withdrawer": "Whitelisted withdrawer"
          }
        },
        "setSystemConfig(address,address)": {
          "params": {
            "_gaugeController": "External gauge controller address",
            "_mintr": "Token minter address for claiming rewards"
          }
        },
        "setVote(bytes32,bool)": {
          "params": {
            "_hash": "Hash of vote signature that was sent to snapshot.org",
            "_valid": "Is the hash valid"
          }
        },
        "withdraw(address)": {
          "details": "Tokens shouldn't end up here if they can help it. However, dao can          set a withdrawer that can process these to some ExtraRewardDistribution."
        },
        "withdraw(address,address,uint256)": {
          "details": "Only callable by the operator ",
          "params": {
            "_amount": "Amount of LP token to withdraw",
            "_gauge": "Gauge for this LP token",
            "_token": "LP token address"
          }
        },
        "withdrawAll(address,address)": {
          "details": "Only callable by the operator ",
          "params": {
            "_gauge": "Gauge for this LP token",
            "_token": "LP token address"
          }
        }
      },
      "title": "VoterProxy",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "claimCrv(address)": {
          "notice": "Claim CRV from Curve"
        },
        "claimFees(address,address)": {
          "notice": "Claim fees (3crv) from staking lp tokens"
        },
        "claimRewards(address)": {
          "notice": "Claim extra rewards from gauge"
        },
        "createLock(uint256,uint256)": {
          "notice": "Lock CRV in curves voting escrow contract"
        },
        "deposit(address,address)": {
          "notice": "Deposit tokens into the Curve Gauge"
        },
        "increaseAmount(uint256)": {
          "notice": "Called by the CrvDepositor to increase amount of locked curve"
        },
        "increaseTime(uint256)": {
          "notice": "Called by the CrvDepositor to increase unlocked time of curve"
        },
        "isValidSignature(bytes32,bytes)": {
          "notice": "Verifies that the hash is valid"
        },
        "release()": {
          "notice": "Withdraw all CRV from Curve's voting escrow contract"
        },
        "setDepositor(address)": {
          "notice": "Set the depositor of the VoterProxy"
        },
        "setOperator(address)": {
          "notice": "Set the operator of the VoterProxy"
        },
        "setRewardDeposit(address,address)": {
          "notice": "Allows dao to set the reward withdrawal address"
        },
        "setSystemConfig(address,address)": {
          "notice": "Allows dao to set the external system config, should it change in the future"
        },
        "setVote(bytes32,bool)": {
          "notice": "Save a vote hash so when snapshot.org asks this contract if           a vote signature is valid we are able to check for a valid hash          and return the appropriate response inline with EIP 1721"
        },
        "vote(uint256,address,bool)": {
          "notice": "Vote on CRV DAO for proposal"
        },
        "voteGaugeWeight(address,uint256)": {
          "notice": "Vote for a single gauge weight via the controller"
        },
        "withdraw(address)": {
          "notice": "Withdraw ERC20 tokens that have been distributed as extra rewards"
        },
        "withdraw(address,address,uint256)": {
          "notice": "Withdraw LP tokens from a gauge "
        },
        "withdrawAll(address,address)": {
          "notice": "Withdraw all LP tokens from a gauge "
        }
      },
      "notice": "VoterProxy whitelisted in the curve SmartWalletWhitelist that          participates in Curve governance. Also handles all deposits since this is           the address that has the voting power.",
      "version": 1
    }
