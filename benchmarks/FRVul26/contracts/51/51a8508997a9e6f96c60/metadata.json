    "devdoc": {
      "details": "Public swapper action. This action allows any user to leverage a public smart vault to perform arbitray swaps.",
      "events": {
        "SourceSet(uint256,bool)": {
          "details": "Emitted every time a source is allowed or disallowed"
        }
      },
      "kind": "dev",
      "methods": {
        "authorize(address,bytes4)": {
          "details": "Authorizes someone to call a function. Sender must be authorize to do so.",
          "params": {
            "what": "Function selector to be granted",
            "who": "Address to be authorized"
          }
        },
        "call(uint8,address,address,uint256,uint256,bytes)": {
          "details": "Swaps two tokens",
          "params": {
            "amountIn": "Amount of tokenIn being swapped",
            "data": "Extra data that may enable or not different behaviors depending on the source picked",
            "minAmountOut": "Minimum amount of tokenOut expected to be received",
            "source": "Source where the swap will be executed.",
            "tokenIn": "Token being sent",
            "tokenOut": "Token being received"
          }
        },
        "constructor": {
          "details": "Creates a new swapper action",
          "params": {
            "admin": "Address that will be granted with admin permissions",
            "registry": "Address of the Mimic Registry"
          }
        },
        "getAllowedSources()": {
          "details": "Tells the list of allowed sources"
        },
        "isAuthorized(address,bytes4)": {
          "details": "Tells whether someone is allowed to call a function or not. It returns true if it's allowed to anyone.",
          "params": {
            "what": "Function selector asking permission for",
            "who": "Address asking permission for"
          }
        },
        "isSourceAllowed(uint256)": {
          "details": "Tells whether a source is allowed or not",
          "params": {
            "source": "Number identifying the source being queried"
          }
        },
        "pause()": {
          "details": "Pause the swap action. Sender must be authorized."
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "setSmartVault(address)": {
          "details": "Sets the Smart Vault tied to the Action. Sender must be authorized. It can be set only once.",
          "params": {
            "newSmartVault": "Address of the smart vault to be set"
          }
        },
        "setSource(uint256,bool)": {
          "details": "Change a source allowance. Sender must be authorized.",
          "params": {
            "allowed": "Whether the source should be allowed or not",
            "source": "Number identifying the source to be set"
          },
          "returns": {
            "success": "True if the source was actually added or removed from the list of allowed sources"
          }
        },
        "unauthorize(address,bytes4)": {
          "details": "Unauthorizes someone to call a function. Sender must be authorize to do so.",
          "params": {
            "what": "Function selector to be revoked",
            "who": "Address to be unauthorized"
          }
        },
        "unpause()": {
          "details": "Unpause the swap action. Sender must be authorized."
        }
      },
      "title": "Swapper",
      "version": 1
    },
