    "devdoc": {
      "kind": "dev",
      "methods": {
        "increaseLockPosition(uint128,uint128)": {
          "details": "Will revert if resulting position has zero lock amount.See `_increasePosition()` for details on inner workings.Sidechain broadcasting is not bundled since it can be done anytime after.",
          "params": {
            "additionalAmountToLock": "pendle amount to be pulled in from user to lock.",
            "newExpiry": "new lock expiry. Must be a valid week beginning, and resulting lock duration (since `block.timestamp`) must be within the allowed range."
          }
        },
        "totalSupplyCurrent()": {
          "details": "See `broadcastTotalSupply()` and `broadcastUserPosition()` for broadcasting"
        },
        "transferOwnership(address,bool,bool)": {
          "params": {
            "direct": "True if `newOwner` should be set immediately. False if `newOwner` needs to use `claimOwnership`.",
            "newOwner": "Address of the new owner.",
            "renounce": "Allows the `newOwner` to be `address(0)` if `direct` and `renounce` is True. Has no effect otherwise."
          }
        },
        "withdraw()": {
          "details": "reverts if position is not expired, or if no locked PENDLE to withdrawbroadcast is not bundled since it can be done anytime after"
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "broadcastTotalSupply(uint256[])": {
          "notice": "updates and broadcast the current totalSupply to different chains"
        },
        "broadcastUserPosition(address,uint256[])": {
          "notice": "updates and broadcast the position of `user` to different chains, also updates and broadcasts totalSupply"
        },
        "claimOwnership()": {
          "notice": "Needs to be called by `pendingOwner` to claim ownership."
        },
        "increaseLockPosition(uint128,uint128)": {
          "notice": "increases the lock position of a user (amount and/or expiry). Applicable even when user has no position or the current position has expired."
        },
        "increaseLockPositionAndBroadcast(uint128,uint128,uint256[])": {
          "notice": "basically a proxy function to call increaseLockPosition & broadcastUserPosition at the same time"
        },
        "totalSupplyCurrent()": {
          "notice": "update & return the current totalSupply, but does not broadcast info to other chains"
        },
        "transferOwnership(address,bool,bool)": {
          "notice": "Transfers ownership to `newOwner`. Either directly or claimable by the new pending owner. Can only be invoked by the current `owner`."
        },
        "withdraw()": {
          "notice": "Withdraws an expired lock position, returns locked PENDLE back to user"
        }
      },
      "version": 1
    }
  },
