          "returns": {
            "rewardsList": "The list of reward addresses",
            "unclaimedAmounts": "The list of unclaimed amount of rewards*"
          }
        },
        "getAssetDecimals(address)": {
          "details": "Returns the decimals of an asset to calculate the distribution delta",
