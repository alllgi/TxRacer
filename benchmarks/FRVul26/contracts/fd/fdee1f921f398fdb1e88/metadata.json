        "delegatedPayWithSwap(address,address,uint256,uint256,bytes32,uint256,bytes)": {
          "notice": "Pay by swapping token for an accepted output token from an authorized delegate. Uses SpritzSwapModule to facilitate the swap"
        },
        "delegatedPayWithToken(address,address,uint256,bytes32)": {
          "notice": "Pay by direct stablecoin transfer from an authorized delegate"
        },
        "payWithNativeSwap(uint256,bytes32,uint256,bytes)": {
          "notice": "Pay by swapping native currency. Uses          Uniswap exact output trade type"
        },
        "payWithSwap(address,uint256,uint256,bytes32,uint256,bytes)": {
          "notice": "Pay by swapping and ERC-20 token. Uses          Uniswap exact output trade type"
        },
        "payWithToken(address,uint256,bytes32)": {
          "notice": "Pay by direct stablecoin transfer"
        }
      },
      "notice": "Main entry point for Spritz payments",
      "version": 1
    }
  },
