            "recipient": "address to receive funds"
          }
        },
        "swapTokenV2(uint256,address,address[],uint256,uint256,uint256)": {
          "params": {
            "_amountIn": "Input amount",
            "_deadline": "the time at which this transaction can no longer be run",
            "_dexId": "ID of the Dex",
            "_minAmountOut": "Output token amount",
            "_path": "Token address array",
            "recipient": "address to receive funds"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "updateDex(uint256,string,address,uint8)": {
          "params": {
            "_name": "pass anything other than an empty string to update the name",
