            "_amountIn": "the amount to simulate trading through the market",
            "factory": "the factory to check for a pair and fee of the market",
            "path": "the tokens being traded from and to"
          }
        },
        "getSingleFeeMinimum(address,uint256,address)": {
          "params": {
            "_amountIn": "the amount of tokens being moved through the market",
            "factory": "the factory to check for a pair",
            "source": "the token to check against wNative"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "swapBalancerV2(uint256,(bytes32,uint256,uint256,uint256,bytes)[],address[],(address,bool,address,bool),int256[],uint256,uint256,uint256,uint256)": {
          "details": "\"uint256(deltas[deltas.length - 1] * -1))\" is because (1) fewer vars because stack too deep (2) deltas are negative for tokens that exit balancer's vault, so we take the last one, our outToken, multiply by negative one, then cast to uint"
        },
        "swapNativeToV2(uint256,address,address[],uint256,uint256,uint256)": {
