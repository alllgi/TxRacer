    "userdoc": {
      "errors": {
        "NativeMissing(uint256)": [
          {
            "notice": "a single dex entry "
          }
        ]
      },
      "kind": "user",
      "methods": {
        "addDex(string,address,address,uint8)": {
          "notice": "Add new Dex"
        },
        "amountOutFrom(address,address,address,uint256)": {
          "notice": "get the amount out from reserves does not take into account fees charged along the way"
        },
        "checkPairForValidPrice(address,address)": {
          "notice": "pull a token and weth reserve out of a provided token and factory to derive a market"
        },
        "clamp(uint256,uint256)": {
          "notice": "clamp the amount provided to a maximum, defaulting to provided maximum if 0 provided "
        },
        "constructor": {
          "notice": "sets up the wallet swap contractwNative does not have to have the name wNative it is just a placeholder for wrapped native currencythe destination address must have a receive / fallback method to receive native currency"
        },
        "destination()": {
          "notice": "where the fees will end upthis address cannot be updated after it is set during constructorthe destination must be payable + have a receive function that has gas consumption less than limit"
        },
        "disableDex(uint256,bool)": {
          "notice": "sets disabled flag on a dex"
        },
        "distribute(uint256)": {
          "notice": "A public method to distribute feesfailure in receipt will cause this tx to fail as well"
        },
        "distributeAll(uint256)": {
          "notice": "distributes all fees, after withdrawing wrapped native balanceif the amount is 0, all funds will be drainedif an amount is provided, the method will only unwrap the wNative token if it does not have enough native balance to cover the amountthe balance will change in the middle of the function if the appropriate conditions are met. however, we do not use that updated balance because the whole amount may not have been asked for"
        },
        "getFeeMinimum(address,uint256,address[])": {
          "notice": "checks the exchange factory pair for a pair with weth and its reserves"
        },
        "getSingleFeeMinimum(address,uint256,address)": {
          "notice": "gets the fee for a single token from the exchange factory pairthe number returned from this method does not check the fee for the market so the calculation will be off by ~0.3% for most markets"
        },
        "pendingDistribution()": {
          "notice": "returns the balance of wNative token and native token, treating them as an aggregate balance for ease"
        },
        "pendingDistributionSegmented()": {
          "notice": "returns the balance in wNative token and native token as two separate numbers"
        },
        "routerToDex(address)": {
          "notice": "map a router to a dex to check if the router was already added, the addition should fail"
        },
        "swapBalancerV2(uint256,(bytes32,uint256,uint256,uint256,bytes)[],address[],(address,bool,address,bool),int256[],uint256,uint256,uint256,uint256)": {
          "notice": "This function is used to swap tokens on Balancer V2, with our fee being taken either before or after as ETH or WETH, depending on tokens swapped"
        },
        "swapNativeToV2(uint256,address,address[],uint256,uint256,uint256)": {
          "notice": "Swap native currency, end with erc20 tokenanything extra in msg.value is treated as a donationthis method does not require an approval step from the userbecause of use of msg.value if this method is used with internal delegatecall to chain calls together, it will, in most cases, not have any msg.value to use"
        },
        "swapToNativeV2(uint256,address,address[],uint256,uint256,uint256)": {
          "notice": "Swap ERC-20 Token, end with native currencyanything extra in msg.value is treated as a donation"
        },
        "swapTokenV2(uint256,address,address[],uint256,uint256,uint256)": {
          "notice": "Swap erc20 token, end with erc20 tokenanything extra in msg.value is treated as a donationanyone using this method will be costing themselves more than simply going through the router they wish to swap through so anything that comes through really acts like a high yeilding voluntary donation boxif wNative is passed in as the first or last step of the path then fees will be calculated from that number available at that timefee is only paid via msg.value if and only if the first and last of the path are not a wrapped tokenif first or last of the path is wNative then msg.value is required to be zero"
        },
        "updateDex(uint256,string,address,uint8)": {
          "notice": "Updates dex info_factory is not used in these contracts it is held for external services to utilize"
        },
        "wNative()": {
          "notice": "the native address to deposit and withdraw from in the swap methodsthis address cannot be updated after it is set during constructor"
        },
        "wrap(address)": {
          "notice": "wraps the provided msg value to be used as a token useful when chaining calls together"
        }
      },
      "notice": "use this contract for only the most basic simulationmulticall was not included here because sender is less relevant outside of a swap which already allows for multiple swaps",
      "version": 1
    }
  },
