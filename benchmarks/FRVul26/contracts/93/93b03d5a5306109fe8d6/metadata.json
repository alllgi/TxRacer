    "devdoc": {
      "kind": "dev",
      "methods": {
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "permit2NextNonce(address)": {
          "params": {
            "owner": "The owner of the nonces"
          },
          "returns": {
            "nonce": "The first valid nonce starting from 0"
          }
        },
        "permit2NextNonceAfter(address,uint256)": {
          "details": "This can be helpful if you're signing multiple nonces in a row and need the next nonce to sign but the start one is still valid.",
          "params": {
            "owner": "The owner of the nonces",
            "start": "The nonce to start from"
          },
          "returns": {
            "nonce": "The first valid nonce after the given nonce"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "uniswapV3SwapCallback(int256,int256,bytes)": {
          "details": "In the implementation you must pay the pool tokens owed for the swap. The caller of this method must be checked to be a UniswapV3Pool deployed by the canonical UniswapV3Factory. amount0Delta and amount1Delta can both be 0 if no tokens were swapped.",
          "params": {
            "amount0Delta": "The amount of token0 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token0 to the pool.",
            "amount1Delta": "The amount of token1 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token1 to the pool.",
            "data": "Any data passed through by the caller via the IUniswapV3PoolActions#swap call"
          }
        },
        "uniswapV3SwapTo(address,uint256,uint256,uint256[])": {
          "params": {
            "amount": "Amount of source tokens to swap",
            "minReturn": "Minimal allowed returnAmount to make transaction commit",
            "pools": "Pools chain used for swaps. Pools src and dst tokens should match to make swap happen",
            "recipient": "Address that will receive swap funds"
          }
        },
        "uniswapV3SwapToWithPermit(address,uint256,uint256,uint256[],bytes,address)": {
          "params": {
            "amount": "Amount of source tokens to swap",
            "minReturn": "Minimal allowed returnAmount to make transaction commit",
            "permit": "Should contain valid permit that can be used in `IERC20Permit.permit` calls.",
            "pools": "Pools chain used for swaps. Pools src and dst tokens should match to make swap happen",
            "recipient": "Address that will receive swap funds",
            "srcToken": "Source token See tests for examples"
          }
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "permit2NextNonce(address)": {
          "notice": "Finds the next valid nonce for a user, starting from 0."
        },
        "permit2NextNonceAfter(address,uint256)": {
          "notice": "Finds the next valid nonce for a user, after from a given nonce."
        },
        "uniswapV3SwapCallback(int256,int256,bytes)": {
          "notice": "Called to `msg.sender` after executing a swap via IUniswapV3Pool#swap."
        },
        "uniswapV3SwapTo(address,uint256,uint256,uint256[])": {
          "notice": "Performs swap using Uniswap V3 exchange. Wraps and unwraps ETH if required. Sending non-zero `msg.value` for anything but ETH swaps is prohibited"
        },
        "uniswapV3SwapToWithPermit(address,uint256,uint256,uint256[],bytes,address)": {
          "notice": "Same as `uniswapV3SwapTo` but calls permit first, allowing to approve token spending and make a swap in one transaction."
        }
      },
      "version": 1
    }
