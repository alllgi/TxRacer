      "kind": "dev",
      "methods": {
        "fillQuoteEthToToken(address,address,bytes,uint256)": {
          "params": {
            "buyTokenAddress": "the address of token that the user should receive",
            "feeAmount": "the amount of ETH that we will take as a fee",
            "swapCallData": "the calldata that will be passed to the aggregator contract",
            "target": "the address of the aggregator contract that will exec the swap"
          }
        },
        "fillQuoteTokenToEth(address,address,bytes,uint256,uint256)": {
          "details": "method that executes ERC20 to ETH token swaps with the ability to take a fee from the output",
          "params": {
            "feePercentageBasisPoints": "the amount of ETH that we will take as a fee in 1e18 basis points (basis points with 4 decimals plus 14 extra decimals of precision)",
            "sellAmount": "the amount of tokens that the user is selling",
            "sellTokenAddress": "the address of token that the user is selling",
            "swapCallData": "the calldata that will be passed to the aggregator contract",
            "target": "the address of the aggregator contract that will exec the swap"
          }
        },
        "fillQuoteTokenToEthWithPermit(address,address,bytes,uint256,uint256,(uint256,uint256,uint256,bool,uint8,bytes32,bytes32))": {
          "params": {
            "feePercentageBasisPoints": "the amount of ETH that we will take as a fee in 1e18 basis points (basis points with 4 decimals plus 14 extra decimals of precision)",
            "permitData": "struct containing the amount, nonce, deadline, v, r and s values of the permit data",
            "sellAmount": "the amount of tokens that the user is selling",
            "sellTokenAddress": "the address of token that the user is selling",
            "swapCallData": "the calldata that will be passed to the aggregator contract",
            "target": "the address of the aggregator contract that will exec the swap"
          }
        },
        "fillQuoteTokenToToken(address,address,address,bytes,uint256,uint256)": {
          "params": {
            "buyTokenAddress": "the address of token that the user should receive",
            "feeAmount": "the amount of the tokens to sell that we will take as a fee",
            "sellAmount": "the amount of tokens that the user is selling",
            "sellTokenAddress": "the address of token that the user is selling",
            "swapCallData": "the calldata that will be passed to the aggregator contract",
            "target": "the address of the aggregator contract that will exec the swap"
          }
        },
        "fillQuoteTokenToTokenWithPermit(address,address,address,bytes,uint256,uint256,(uint256,uint256,uint256,bool,uint8,bytes32,bytes32))": {
          "params": {
            "buyTokenAddress": "the address of token that the user should receive",
            "feeAmount": "the amount of the tokens to sell that we will take as a fee",
            "permitData": "struct containing the value, nonce, deadline, v, r and s values of the permit data",
            "sellAmount": "the amount of tokens that the user is selling",
            "sellTokenAddress": "the address of token that the user is selling",
            "swapCallData": "the calldata that will be passed to the aggregator contract",
            "target": "the address of the aggregator contract that will exec the swap"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`).",
          "params": {
            "newOwner": "address of the new owner Can only be called by the current owner."
          }
        },
        "updateSwapTargets(address,bool)": {
          "details": "method to add or remove swap targets from swapTargets This is required so we only approve \"trusted\" swap targets to transfer tokens out of this contract",
          "params": {
            "add": "flag to add or remove the swap target",
            "target": "address of the swap target to add"
          }
        },
        "withdrawEth(address,uint256)": {
          "details": "method to withdraw ETH (from the fees)",
          "params": {
            "amount": "amount of ETH to withdraw",
            "to": "address that's receiving the ETH"
          }
        },
        "withdrawToken(address,address,uint256)": {
          "details": "method to withdraw ERC20 tokens (from the fees)",
          "params": {
            "amount": "amount of tokens to withdraw",
            "to": "address that's receiving the tokens",
            "token": "address of the token to withdraw"
          }
        }
