    "devdoc": {
      "methods": {
        "allowance(address,address)": {
          "details": "Function to check the amount of tokens that an owner has allowed to a spender.\r",
          "params": {
            "owner_": "The address which owns the funds.\r",
            "spender": "The address which will spend the funds.\r"
          },
          "return": "The number of tokens still available for the spender.\r"
        },
        "approve(address,uint256)": {
          "details": "Approve the passed address to spend the specified amount of tokens on behalf of\r msg.sender. This method is included for ERC20 compatibility.\r increaseAllowance and decreaseAllowance should be used instead.\r Changing an allowance with this method brings the risk that someone may transfer both\r the old and the new allowance - if they are both greater than zero - if a transfer\r transaction is mined before the later approve() call is mined.\r ",
          "params": {
            "spender": "The address which will spend the funds.\r",
            "value": "The amount of tokens to be spent.\r"
          }
        },
        "balanceOf(address)": {
          "params": {
            "who": "The address to query.\r"
          },
          "return": "The balance of the specified address.\r"
        },
        "decimals()": {
          "return": "the number of decimals of the token.\r"
        },
        "decreaseAllowance(address,uint256)": {
          "details": "Decrease the amount of tokens that an owner has allowed to a spender.\r ",
          "params": {
            "spender": "The address which will spend the funds.\r",
            "subtractedValue": "The amount of tokens to decrease the allowance by.\r"
          }
        },
        "increaseAllowance(address,uint256)": {
          "details": "Increase the amount of tokens that an owner has allowed to a spender.\r This method should be used instead of approve() to avoid the double approval vulnerability\r described above.\r",
          "params": {
            "addedValue": "The amount of tokens to increase the allowance by.\r",
            "spender": "The address which will spend the funds.\r"
          }
        },
        "isOwner()": {
          "return": "true if `msg.sender` is the owner of the contract.\r"
        },
        "name()": {
          "return": "the name of the token.\r"
        },
        "owner()": {
          "return": "the address of the owner.\r"
        },
        "rebase(uint256,int256)": {
          "details": "Notifies Fragments contract about a new rebase cycle.\r",
          "params": {
            "supplyDelta": "The number of new fragment tokens to add into circulation via expansion.\r"
          },
          "return": "The total number of fragments after the supply adjustment.\r"
        },
        "renounceOwnership()": {
          "details": "Allows the current owner to relinquish control of the contract.\r"
        },
        "setMonetaryPolicy(address)": {
          "params": {
            "monetaryPolicy_": "The address of the monetary policy contract to use for authentication.\r"
          }
        },
        "setRebasePaused(bool)": {
          "details": "Pauses or unpauses the execution of rebase operations.\r",
          "params": {
            "paused": "Pauses rebase operations if this is true.\r"
          }
        },
        "setTokenPaused(bool)": {
          "details": "Pauses or unpauses execution of ERC-20 transactions.\r",
          "params": {
            "paused": "Pauses ERC-20 transactions if this is true.\r"
          }
        },
        "symbol()": {
          "return": "the symbol of the token.\r"
        },
        "totalSupply()": {
          "return": "The total number of fragments.\r"
        },
        "transfer(address,uint256)": {
          "details": "Transfer tokens to a specified address.\r",
          "params": {
            "to": "The address to transfer to.\r",
            "value": "The amount to be transferred.\r"
          },
          "return": "True on success, false otherwise.\r"
        },
        "transferFrom(address,address,uint256)": {
          "details": "Transfer tokens from one address to another.\r",
          "params": {
            "from": "The address you want to send tokens from.\r",
            "to": "The address you want to transfer to.\r",
            "value": "The amount of tokens to be transferred.\r"
          }
        },
        "transferOwnership(address)": {
          "details": "Allows the current owner to transfer control of the contract to a newOwner.\r",
          "params": {
            "newOwner": "The address to transfer ownership to.\r"
          }
        }
      },
      "title": "uFragments ERC20 token\r"
    },
    "userdoc": {
      "methods": {
        "renounceOwnership()": {
          "notice": "Renouncing to ownership will leave the contract without an owner.\r It will not be possible to call the functions with the `onlyOwner`\r modifier anymore.\r"
        }
      }
    }
