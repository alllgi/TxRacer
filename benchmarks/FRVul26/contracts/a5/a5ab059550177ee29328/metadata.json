    "devdoc": {
      "events": {
        "AdminChanged(address,address)": {
          "details": "Emitted when the admin account has changed."
        },
        "AssetRegistered(address,address)": {
          "params": {
            "asset": "The asset contract added to the registry",
            "erc20": "The ERC20 contract for the asset"
          }
        },
        "AssetUnregistered(address,address)": {
          "params": {
            "asset": "The asset contract removed from the registry",
            "erc20": "The ERC20 contract for the asset"
          }
        },
        "BeaconUpgraded(address)": {
          "details": "Emitted when the beacon is changed."
        },
        "Initialized(uint8)": {
          "details": "Triggered when the contract has been initialized or reinitialized."
        },
        "Upgraded(address)": {
          "details": "Emitted when the implementation is upgraded."
        }
      },
      "kind": "dev",
      "methods": {
        "getRegistry()": {
          "returns": {
            "reg": "The list of registered ERC20s and Assets, in the same order"
          }
        },
        "proxiableUUID()": {
          "details": "Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."
        },
        "refresh()": {
          "custom:refresher": ""
        },
        "register(address)": {
          "custom:governance": "",
          "returns": {
            "_0": "true if the erc20 address was not already registered."
          }
        },
        "size()": {
          "returns": {
            "_0": "The number of registered ERC20s"
          }
        },
        "swapRegistered(address)": {
          "custom:governance": "",
          "returns": {
            "swapped": "If the asset was swapped for a previously-registered asset"
          }
        },
        "unregister(address)": {
          "custom:governance": ""
        },
        "upgradeTo(address)": {
          "custom:oz-upgrades-unsafe-allow-reachable": "delegatecall",
          "details": "Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."
        },
        "upgradeToAndCall(address,bytes)": {
          "custom:oz-upgrades-unsafe-allow-reachable": "delegatecall",
          "details": "Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."
        }
      },
      "stateVariables": {
        "__gap": {
          "details": "This empty reserved space is put in place to allow future versions to add new variables without shifting down storage in the inheritance chain. See https://docs.openzeppelin.com/contracts/4.x/upgradeable#storage_gaps AssetRegistry uses 52 slots, not 50."
        },
        "lastRefresh": {
          "return": "{s} The timestamp of the last refresh",
          "returns": {
            "_0": "{s} The timestamp of the last refresh"
          }
        }
      },
      "version": 1
    },
    "userdoc": {
      "events": {
        "AssetRegistered(address,address)": {
          "notice": "Emitted when an asset is added to the registry"
        },
        "AssetUnregistered(address,address)": {
          "notice": "Emitted when an asset is removed from the registry"
        }
      },
      "kind": "user",
      "methods": {
        "erc20s()": {
          "notice": "Returns keys(assets) as a (duplicate-free) list."
        },
        "init(address,address[])": {
          "notice": "Initialize the AssetRegistry with assets"
        },
        "isRegistered(address)": {
          "notice": "Returns true if erc20 is registered."
        },
        "refresh()": {
          "notice": "Update the state of all assets"
        },
        "register(address)": {
          "notice": "Register `asset` If either the erc20 address or the asset was already registered, fail"
        },
        "swapRegistered(address)": {
          "notice": "Register `asset` if and only if its erc20 address is already registered. If the erc20 address was not registered, revert."
        },
        "toAsset(address)": {
          "notice": "Return the Asset registered for erc20; revert if erc20 is not registered."
        },
        "toColl(address)": {
          "notice": "Return the Collateral registered for erc20; revert if erc20 is not registered as Collateral"
        },
        "unregister(address)": {
          "notice": "Unregister an asset, requiring that it is already registered Rewards are NOT claimed by default when unregistering due to security concerns. If the collateral is secure, governance should claim rewards before unregistering."
        }
      },
      "notice": "The AssetRegistry provides the mapping from ERC20 to Asset, allowing the rest of Main to think in terms of ERC20 tokens and target/ref units.",
      "version": 1
    }
