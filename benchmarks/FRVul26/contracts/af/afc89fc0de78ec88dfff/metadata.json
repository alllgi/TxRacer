    "devdoc": {
      "methods": {
        "allowRecoverability(address)": {
          "details": "Disable recovery escape hatch for own token,\r     as the it has the concept of issuing tokens without assigning them\r"
        },
        "assign(address,uint256)": {
          "params": {
            "_amount": "Number of tokens transferred\r",
            "_receiver": "The address receiving the tokens\r"
          }
        },
        "assignVested(address,uint256,uint64,uint64,uint64,bool)": {
          "params": {
            "_amount": "Number of tokens vested\r",
            "_cliff": "Date when the initial portion of tokens are transferable\r",
            "_receiver": "The address receiving the tokens, cannot be Token Manager itself\r",
            "_revokable": "Whether the vesting can be revoked by the Token Manager\r",
            "_start": "Date the vesting calculations start\r",
            "_vested": "Date when all tokens are transferable\r"
          }
        },
        "burn(address,uint256)": {
          "params": {
            "_amount": "Number of tokens being burned\r",
            "_holder": "Holder of tokens being burned\r"
          }
        },
        "canPerform(address,bytes32,uint256[])": {
          "details": "Check whether an action can be performed by a sender for a particular role on this app\r",
          "params": {
            "_params": "Permission params for the role\r",
            "_role": "Role on this app\r",
            "_sender": "Sender of the call\r"
          },
          "return": "Boolean indicating whether the sender has the permissions to perform the action.\r        Always returns false if the app hasn't been initialized yet.\r"
        },
        "forward(bytes)": {
          "details": "IForwarder interface conformance. Forwards any token holder action.\r",
          "params": {
            "_evmScript": "Script being executed\r"
          }
        },
        "getInitializationBlock()": {
          "return": "Block number in which the contract was initialized\r"
        },
        "getRecoveryVault()": {
          "details": "Get the recovery vault for the app\r",
          "return": "Recovery vault address for the app\r"
        },
        "hasInitialized()": {
          "return": "Whether the contract has been initialized by the time of the current block\r"
        },
        "initialize(address,bool,uint256)": {
          "params": {
            "_maxAccountTokens": "Maximum amount of tokens an account can have (0 for infinite tokens)\r",
            "_token": "MiniMeToken address for the managed token (Token Manager instance must be already set as the token controller)\r",
            "_transferable": "whether the token can be transferred by holders\r"
          }
        },
        "issue(uint256)": {
          "params": {
            "_amount": "Number of tokens minted\r"
          }
        },
        "mint(address,uint256)": {
          "params": {
            "_amount": "Number of tokens minted\r",
            "_receiver": "The address receiving the tokens, cannot be the Token Manager itself (use `issue()` instead)\r"
          }
        },
        "onApprove(address,address,uint256)": {
          "details": "Notifies the controller about an approval allowing the controller to react if desired\r     Initialization check is implicitly provided by `onlyToken()`.\r",
          "return": "False if the controller does not authorize the approval\r"
        },
        "proxyPayment(address)": {
          "details": "Called when ether is sent to the MiniMe Token contract\r     Initialization check is implicitly provided by `onlyToken()`.\r",
          "return": "True if the ether is accepted, false for it to throw\r"
        },
        "revokeVesting(address,uint256)": {
          "params": {
            "_holder": "Address whose vesting to revoke\r",
            "_vestingId": "Numeric id of the vesting\r"
          }
        },
        "transferToVault(address)": {
          "params": {
            "_token": "Token balance to be sent to recovery vault.\r"
          }
        }
      }
    },
    "userdoc": {
      "methods": {
        "assign(address,uint256)": {
          "notice": "Assign `@tokenAmount(self.token(): address, _amount, false)` tokens to `_receiver` from the Token Manager's holdings\r"
        },
        "assignVested(address,uint256,uint64,uint64,uint64,bool)": {
          "notice": "Assign `@tokenAmount(self.token(): address, _amount, false)` tokens to `_receiver` from the Token Manager's holdings with a `_revokable : 'revokable' : ''` vesting starting at `@formatDate(_start)`, cliff at `@formatDate(_cliff)` (first portion of tokens transferable), and completed vesting at `@formatDate(_vested)` (all tokens transferable)\r"
        },
        "burn(address,uint256)": {
          "notice": "Burn `@tokenAmount(self.token(): address, _amount, false)` tokens from `_holder`\r"
        },
        "forward(bytes)": {
          "notice": "Execute desired action as a token holder\r"
        },
        "initialize(address,bool,uint256)": {
          "notice": "Initialize Token Manager for `_token.symbol(): string`, whose tokens are `transferable ? 'not' : ''` transferable`_maxAccountTokens > 0 ? ' and limited to a maximum of ' + @tokenAmount(_token, _maxAccountTokens, false) + ' per account' : ''`\r"
        },
        "issue(uint256)": {
          "notice": "Mint `@tokenAmount(self.token(): address, _amount, false)` tokens for the Token Manager\r"
        },
        "mint(address,uint256)": {
          "notice": "Mint `@tokenAmount(self.token(): address, _amount, false)` tokens for `_receiver`\r"
        },
        "revokeVesting(address,uint256)": {
          "notice": "Revoke vesting #`_vestingId` from `_holder`, returning unvested tokens to the Token Manager\r"
        },
        "transferToVault(address)": {
          "notice": "Send funds to recovery Vault. This contract should never receive funds,\r        but in case it does, this function allows one to recover them.\r"
        }
      }
    }
  },
