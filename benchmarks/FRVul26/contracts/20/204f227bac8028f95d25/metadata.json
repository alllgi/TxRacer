    "devdoc": {
      "details": "kyberFeeHandler works tightly with contracts kyberNetwork and kyberDao.  Some events are moved to interface, for easier usageTerminology:  Epoch - Voting campaign time frame in kyberDao.    kyberDao voting campaigns are in the scope of epochs.  BRR - Burn / Reward / Rebate. kyberNetwork fee is used for 3 purposes:    Burning KNC    Reward an address that staked knc in kyberStaking contract. AKA - stakers    Rebate reserves for supporting trades.Code flow:   Per trade on kyberNetwork, it calls handleFees() function which   internally accounts for network & platform fees from the trade.    Fee distribution:     rewards: send to fee pool     rebates: accumulated per rebate wallet, can be claimed any time.     burn: accumulated in the contract. Burned value and interval limited with safe check using       sanity rate.     Platfrom fee: accumulated per platform wallet, can be claimed any time.",
      "methods": {
        "burnKnc()": {
          "details": "Burn knc. The burn amount is limited. Forces block delay between burn calls.only none ontract can call this function",
          "returns": {
            "kncBurnAmount": "amount of knc burned"
          }
        },
        "claimPlatformFee(address)": {
          "details": "claim accumulated fee per platform wallet. Called by any addressTotal accumulated fee sent to this wallet.",
          "params": {
            "platformWallet": "the wallet to claim fee for."
          },
          "returns": {
            "amountWei": "amount of fee claimed"
          }
        },
        "claimReserveRebate(address)": {
          "details": "claim rebate per reserve wallet. called by any addressTotal accumulated rebate sent to this wallet.",
          "params": {
            "rebateWallet": "the wallet to claim rebates for. "
          },
          "returns": {
            "amountWei": "amount of rebate claimed"
          }
        },
        "claimStakerReward(address,uint256)": {
          "details": "implement so this contract is not marked as abstract"
        },
        "getLatestSanityRate()": {
          "details": "return latest knc/eth rate from sanity rate contract"
        },
        "getSanityRateContracts()": {
          "details": "returns list of sanity rate contractsindex 0 is currently used contract address, indexes > 0 are older versions"
        },
        "handleFees(address,address[],uint256[],address,uint256,uint256)": {
          "details": "handleFees function is called per trade on kyberNetworkunless the trade is not involving any fees.",
          "params": {
            "networkFee": "Fee amount (in wei) to be allocated for BRR",
            "platformFee": "Fee amount (in wei) the platfrom wallet is entitled to.",
            "platformWallet": "Wallet address that will receive the platfrom fee.",
            "rebateBpsPerWallet": "percentage of rebate for each wallet, out of total rebate.",
            "rebateWallets": "a list of rebate wallets that will get rebate for this trade.",
            "token": "Token currency of fees"
          }
        },
        "setBRRData(uint256,uint256,uint256)": {
          "details": "only call by daoOperator"
        },
        "setBurnConfigParams(address,uint256)": {
          "details": "set knc sanity rate contract and amount wei to burn",
          "params": {
            "_sanityRate": "new sanity rate contract",
            "_weiToBurn": "new amount of wei to burn"
          }
        },
        "setKyberProxy(address)": {
          "details": "Allow to set kyberNetworkProxy address by daoOperator",
          "params": {
            "_newProxy": "new kyberNetworkProxy contract"
          }
        }
      },
      "title": "kyberFeeHandler"
    },
    "userdoc": {
      "methods": {
        "getSanityRateContracts()": {
          "notice": "should be called off chain"
        }
      }
    }
