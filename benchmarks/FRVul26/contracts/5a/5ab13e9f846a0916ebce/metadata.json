    "devdoc": {
      "author": "31Third Provides batch trading functionality",
      "kind": "dev",
      "methods": {
        "addFeelessWallet(address)": {
          "params": {
            "_feelessWallet": "Wallet address to add"
          }
        },
        "addFeelessWallets(address[])": {
          "params": {
            "_feelessWallets": "Wallet addresses to add"
          }
        },
        "batchTrade((string,address,uint256,address,uint256,bytes,bytes)[],(bool,bool))": {
          "params": {
            "_batchTradeConfig": "Struct that holds batch trade configs",
            "_trades": "Struct with information for trades"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "receiveFees(address[])": {
          "params": {
            "_feeTokensToReceive": "Addresses of the tokens that should be sent to the fee recipient"
          }
        },
        "reduceMaxBasisPoints(uint16)": {
          "params": {
            "_newMaxFeeBasisPoints": "New max basis points"
          }
        },
        "removeFeelessWallet(address)": {
          "params": {
            "_feelessWallet": "Wallet address to remove"
          }
        },
        "removeFeelessWallets(address[])": {
          "params": {
            "_feelessWallets": "Wallet addresses to remove"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "updateBasisPoints(uint16)": {
          "params": {
            "_newFeeBasisPoints": "New basis points"
          }
        },
        "updateFeeRecipient(address)": {
          "params": {
            "_newFeeRecipient": "New fee recipient"
          }
        },
        "updateTradeSigner(address)": {
          "params": {
            "_newTradeSigner": "New trade signer"
          }
        }
      },
      "title": "BatchTrade",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "activate()": {
          "notice": "ONLY OWNER: Activates BatchTrade."
        },
        "addFeelessWallet(address)": {
          "notice": "ONLY OWNER: Adds wallet that is eligible for feeless batch trading."
        },
        "addFeelessWallets(address[])": {
          "notice": "ONLY OWNER: Adds wallets that are eligible for feeless batch trading."
        },
        "batchTrade((string,address,uint256,address,uint256,bytes,bytes)[],(bool,bool))": {
          "notice": "WHEN NOT PAUSED, NON REENTRANT: Executes a batch of trades on supported DEXs. If trades fail events will be emitted. Based on the passed batchTradeConfig either the whole batch trade will be reverted or the execution stops at the first failing trade."
        },
        "deactivate()": {
          "notice": "ONLY OWNER: Deactivates BatchTrade."
        },
        "receiveFees(address[])": {
          "notice": "Sends accrued fees to fee recipient. (Also supports inflationary and yield generating tokens.)"
        },
        "reduceMaxBasisPoints(uint16)": {
          "notice": "ONLY OWNER: Reduces max basis points (Must be less than max and bigger or equal current fee basis points)."
        },
        "removeFeelessWallet(address)": {
          "notice": "ONLY OWNER: Removes wallet that is eligible for feeless batch trading."
        },
        "removeFeelessWallets(address[])": {
          "notice": "ONLY OWNER: Removes wallets that are eligible for feeless batch trading."
        },
        "renounceOwnership()": {
          "notice": "ONLY OWNER: Override renounceOwnership to disable it"
        },
        "updateBasisPoints(uint16)": {
          "notice": "ONLY OWNER: Updates basis points (Must be less than or equal max)."
        },
        "updateFeeRecipient(address)": {
          "notice": "ONLY OWNER: Updates fee recipient."
        },
        "updateTradeSigner(address)": {
          "notice": "ONLY OWNER: Updates trade signer. (No event is emitted on purpose)"
        }
      },
      "version": 1
    }
