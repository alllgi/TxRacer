        },
        "wrap(uint256)": {
          "notice": "Wraps eEth"
        },
        "wrapWithPermit(uint256,(uint256,uint256,uint8,bytes32,bytes32))": {
          "notice": "Wraps eEth with PermitInput struct so user does not have to call approve on eeth contract"
        }
      },
