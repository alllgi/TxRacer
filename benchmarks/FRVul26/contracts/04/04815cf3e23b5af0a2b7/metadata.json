    "devdoc": {
      "author": "Semiotic AI",
      "events": {
        "SwapMulti(address,uint256[],address[],uint256[],address[],uint32)": {
          "details": "event for swapping multiple input and/or output tokens"
        }
      },
      "kind": "dev",
      "methods": {
        "constructor": {
          "details": "Set the null referralCode as \"Unregistered\" with no additional fee"
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "registerReferralCode(uint32,uint64,address)": {
          "params": {
            "_beneficiary": "the address to send the referral's share of fees to",
            "_referralCode": "the referral code to use for the new referral",
            "_referralFee": "the additional fee to add to each swap using this code"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "setSwapMultiFee(uint256)": {
          "params": {
            "_swapMultiFee": "the new fee for swapMulti"
          }
        },
        "swap((address,uint256,address,address,uint256,uint256,address),bytes,address,uint32)": {
          "params": {
            "executor": "Address of contract that will execute the path",
            "pathDefinition": "Encoded path definition for executor",
            "referralCode": "referral code to specify the source of the swap",
            "tokenInfo": "All information about the tokens being swapped"
          }
        },
        "swapMulti((address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address,uint32)": {
          "params": {
            "executor": "Address of contract that will execute the path",
            "inputs": "list of input token structs for the path being executed",
            "outputs": "list of output token structs for the path being executed",
            "pathDefinition": "Encoded path definition for executor",
            "referralCode": "referral code to specify the source of the swap",
            "valueOutMin": "minimum amount of value out the user will accept"
          }
        },
        "swapMultiPermit2((address,uint256,uint256,bytes),(address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address,uint32)": {
          "params": {
            "executor": "Address of contract that will execute the path",
            "inputs": "list of input token structs for the path being executed",
            "outputs": "list of output token structs for the path being executed",
            "pathDefinition": "Encoded path definition for executor",
            "permit2": "All additional info for Permit2 transfers",
            "referralCode": "referral code to specify the source of the swap",
            "valueOutMin": "minimum amount of value out the user will accept"
          }
        },
        "swapPermit2((address,uint256,uint256,bytes),(address,uint256,address,address,uint256,uint256,address),bytes,address,uint32)": {
          "params": {
            "executor": "Address of contract that will execute the path",
            "pathDefinition": "Encoded path definition for executor",
            "permit2": "All additional info for Permit2 transfers",
            "referralCode": "referral code to specify the source of the swap",
            "tokenInfo": "All information about the tokens being swapped"
          }
        },
        "swapRouterFunds((address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address)": {
          "params": {
            "executor": "Address of contract that will execute the path",
            "inputs": "list of input token structs for the path being executed",
            "outputs": "list of output token structs for the path being executed",
            "pathDefinition": "Encoded path definition for executor",
            "valueOutMin": "minimum amount of value out the user will accept"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "transferRouterFunds(address[],uint256[],address)": {
          "params": {
            "amounts": "List of amounts of each token to be transferred",
            "dest": "Address to which the funds should be sent",
            "tokens": "List of token address to be transferred"
          }
        },
        "writeAddressList(address[])": {
          "params": {
            "addresses": "list of addresses to be added to the cached address list"
          }
        }
      },
      "stateVariables": {
        "_ETH": {
          "details": "The zero address is uniquely used to represent eth since it is already recognized as an invalid ERC20, and due to its gas efficiency"
        },
        "addressListStart": {
          "details": "Address list where addresses can be cached for use when reading from storage is cheaper"
        },
        "referralLookup": {
          "details": "Register referral fee and information"
        }
      },
      "title": "Routing contract for Odos SOR",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "registerReferralCode(uint32,uint64,address)": {
          "notice": "Register a new referrer, optionally with an additional swap fee"
        },
        "setSwapMultiFee(uint256)": {
          "notice": "Set the fee used for swapMulti"
        },
        "swap((address,uint256,address,address,uint256,uint256,address),bytes,address,uint32)": {
          "notice": "Externally facing interface for swapping two tokens"
        },
        "swapCompact()": {
          "notice": "Custom decoder to swap with compact calldata for efficient execution on L2s"
        },
        "swapMulti((address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address,uint32)": {
          "notice": "Externally facing interface for swapping between two sets of tokens"
        },
        "swapMultiCompact()": {
          "notice": "Custom decoder to swapMulti with compact calldata for efficient execution on L2s"
        },
        "swapMultiPermit2((address,uint256,uint256,bytes),(address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address,uint32)": {
          "notice": "Externally facing interface for swapping between two sets of tokens with Permit2"
        },
        "swapPermit2((address,uint256,uint256,bytes),(address,uint256,address,address,uint256,uint256,address),bytes,address,uint32)": {
          "notice": "Externally facing interface for swapping two tokens"
        },
        "swapRouterFunds((address,uint256,address)[],(address,uint256,address)[],uint256,bytes,address)": {
          "notice": "Directly swap funds held in router "
        },
        "transferRouterFunds(address[],uint256[],address)": {
          "notice": "Allows the owner to transfer funds held by the router contract"
        },
        "writeAddressList(address[])": {
          "notice": "Push new addresses to the cached address list for when storage is cheaper than calldata"
        }
      },
      "notice": "Wrapper with security gaurentees around execution of arbitrary operations on user tokens",
