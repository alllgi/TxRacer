    "devdoc": {
      "details": "A generic proxy contract which extracts a fee before delegation",
      "kind": "dev",
      "methods": {
        "constructor": {
          "details": "Construct this contract and specify a fee beneficiary, 0x proxy contract address, and allowance target"
        },
        "getFunctionImplementation(bytes4)": {
          "details": "Get function implementation address based on signature ",
          "params": {
            "signature": "function signature"
          },
          "returns": {
            "impl": "address of implementation"
          }
        },
        "optimalSwap(bytes,address,uint256)": {
          "details": "Delegates calls to the specified implementation contract and extracts a fee based on provided arguments",
          "params": {
            "fee": "Fee amount collected and sent to the beneficiary",
            "feeToken": "The ERC20 we wish to extract a user fee from. If this is ETH it should be the standard 0xeee ETH address",
            "msgData": "The byte data representing a swap using the original ZeroEx contract. This is either recieved from the 0x API directly or we construct it in order to perform a Uniswap trade"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "proxiedSwap(bytes,address,address,uint256,address,uint256)": {
          "details": "Forwards calls to the zeroEx contract and extracts a fee based on provided arguments",
          "params": {
            "fee": "Fee amount collected and sent to the beneficiary",
            "feeToken": "The ERC20 we wish to extract a user fee from. If this is ETH it should be the standard 0xeee ETH address",
            "inputAmount": "The amount of _inputToken being sold",
            "inputToken": "The ERC20 the user is selling. If this is ETH it should be the standard 0xeee ETH address",
            "msgData": "The byte data representing a swap using the original ZeroEx contract. This is either recieved from the 0x API directly or we construct it in order to perform a Uniswap trade",
            "outputToken": "The ERC20 the user is buying. If this is ETH it should be the standard 0xeee ETH address"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "setAllowanceTarget(address)": {
          "details": "Set a new new allowance target address ",
          "params": {
            "newAllowanceTarget": "New allowance target address"
          }
        },
        "setBeneficiary(address)": {
          "details": "Set a new beneficiary address ",
          "params": {
            "beneficiary": "New beneficiary target address"
          }
        },
        "setImplementationOverride(bytes4,address)": {
          "details": "Set a custom implementation feature  ",
          "params": {
            "implementation": "address of the custom feature",
            "signature": "function signature"
          }
        },
        "setZeroEx(address)": {
          "details": "Set a new 0x proxy contract address",
          "params": {
            "newZeroEx": "New 0x proxy address"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        }
      },
      "title": "Coinbase proxy contract for 0x proxy",
      "version": 1
    },
