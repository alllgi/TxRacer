      "author": "LI.FI (https://li.fi)",
      "custom:version": "1.0.0",
      "kind": "dev",
      "methods": {
        "lzCompose(address,bytes32,bytes,address,bytes)": {
          "details": "This function is called by Stargate Router via LayerZero endpoint (sendCompose(...) function)",
          "params": {
            "": "* (unused) Additional arbitrary data in bytes passed by the entity who executes the lzCompose",
            "_from": "The address initiating the composition, typically the OApp where the lzReceive was called",
            "_message": "The composed message payload in bytes. NOT necessarily the same payload passed via lzReceive"
          }
        },
        "pullToken(address,address,uint256)": {
          "params": {
            "amount": "amount of token",
            "assetId": "address of the token to be withdrawn (not to be confused with StargateV2's assetIds which are uint16 values)",
            "receiver": "address that will receive tokens in the end"
          }
        },
        "transferOwnership(address)": {
          "params": {
            "_newOwner": "the address to transfer ownership to"
          }
        }
      },
      "title": "ReceiverStargateV2",
      "version": 1
