        ]
      },
      "events": {
        "VestSet(address,uint96)": {
          "notice": "This event is emitted whenever a token vest is created or modified."
        }
      },
      "kind": "user",
      "methods": {
        "constructor": {
          "notice": "Our very simple constructor mints the entire token supply to the owner from whence it is distributed to claims and vests and vaults."
        },
        "name()": {
          "notice": "Returns the name of the token."
        },
        "pushVest(uint96,uint256)": {
          "notice": "A function allowing vested tokens to be pushed to the `msg.sender`."
        },
        "setVest((address,uint96,uint32,uint32,uint96)[])": {
          "notice": "Allow the owner to set vests for this token. The owner must take care not to create invalid vests."
        },
        "symbol()": {
          "notice": "Returns the symbol of the token."
        },
        "transferEther(address,uint256)": {
          "notice": "Allow the owner to transfer Ether out of this contract. We only need this to rescue anyone dumb."
        },
        "transferToken(address,address,uint256)": {
          "notice": "Allow the owner to transfer ERC-20 tokens out of this contract. We only need this to rescue anyone dumb."
        },
        "vests(address,uint96)": {
          "notice": "A mapping of addresses to their `vestId`-identified `Vest`s."
        }
      },
      "version": 1
