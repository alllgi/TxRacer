    "devdoc": {
      "author": "ConvexFinance",
      "details": "The rewards are sent to this contract for distribution to stakers. This          contract does not hold any of the staking tokens it just maintains a virtual          balance of what a user has staked in the staking pool (BaseRewardPool).          For example the Booster sends veCRV fees (3Crv) to a VirtualBalanceRewardPool          which tracks the virtual balance of cxvCRV stakers and distributes their share          of 3Crv rewards",
      "kind": "dev",
      "methods": {
        "constructor": {
          "params": {
            "deposit_": "Parent deposit pool e.g cvxCRV staking in BaseRewardPool",
            "op_": "Operator contract (Booster)",
            "reward_": "The rewards token e.g 3Crv"
          }
        },
        "getReward(address)": {
          "details": "This can be called directly but it is usually called by the          BaseRewardPool getReward when the BaseRewardPool loops through          it's extraRewards array calling getReward on all of them"
        },
        "stake(address,uint256)": {
          "details": "Callable by the deposits address which is the BaseRewardPool          this updates the virtual balance of this user as this contract doesn't          actually hold any staked tokens it just diributes reward tokens"
        },
        "withdraw(address,uint256)": {
          "details": "See stake"
        }
      },
      "title": "VirtualBalanceRewardPool",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "getReward(address)": {
          "notice": "Get rewards for this account"
        },
        "stake(address,uint256)": {
          "notice": "Update reward, emit, call linked reward's stake"
        },
        "withdraw(address,uint256)": {
          "notice": "Withdraw stake and update reward, emit, call linked reward's stake"
        }
      },
      "notice": "Reward pool used for ExtraRewards in Booster lockFees (3crv) and          Extra reward stashes",
      "version": 1
    }
