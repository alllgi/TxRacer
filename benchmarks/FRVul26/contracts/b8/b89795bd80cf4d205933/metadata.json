    "devdoc": {
      "author": "Zeropoint Labs",
      "details": "Asserts LiFi input txData is valid",
      "errors": {
        "BLACKLISTED_SELECTOR()": [
          {
            "details": "error thrown when txData selector of lifi bridge is a blacklisted selector"
          }
        ],
        "CANNOT_DECODE_FINAL_SWAP_OUTPUT_TOKEN()": [
          {
            "details": "thrown if we try to decode the final swap output token in a xChain liquidity bridging action"
          }
        ],
        "INVALID_ACTION()": [
          {
            "details": "thrown if a certain action of the user is not allowed given the txData provided"
          }
        ],
        "INVALID_DEPOSIT_LIQ_DST_CHAIN_ID()": [
          {
            "details": "thrown if in deposits, the liqDstChainId doesn't match the stateReq dstChainId"
          }
        ],
        "INVALID_INTERIM_TOKEN()": [
          {
            "details": "forbid xChain deposits with destination swaps without interim token set (for user protection)"
          }
        ],
        "INVALID_TXDATA_CHAIN_ID()": [
          {
            "details": "thrown if the chain id in the txdata is invalid"
          }
        ],
        "INVALID_TXDATA_NO_DESTINATIONCALL_ALLOWED()": [
          {
            "details": "thrown if the validation of bridge txData fails due to a destination call present"
          }
        ],
        "INVALID_TXDATA_RECEIVER()": [
          {
            "details": "thrown if the validation of bridge txData fails due to wrong receiver"
          }
        ],
        "INVALID_TXDATA_TOKEN()": [
          {
            "details": "thrown if the validation of bridge txData fails due to wrong token"
          }
        ],
        "NOT_BLACKLISTED_SELECTOR()": [
          {
            "details": "error thrown when txData selector of lifi bridge is not a blacklisted selector"
          }
        ],
        "NOT_EMERGENCY_ADMIN()": [
          {
            "details": "thrown if msg.sender is not emergency admin"
          }
        ],
        "ZERO_ADDRESS()": [
          {
            "details": "thrown if address input is address 0"
          }
        ]
      },
      "events": {
        "AddedToBlacklist(bytes4)": {
          "details": "emitted when a selector is added to the blacklist"
        },
        "RemovedFromBlacklist(bytes4)": {
          "details": "emitted when a selector is removed from the blacklist"
        }
      },
      "kind": "dev",
      "methods": {
        "addToBlacklist(bytes4)": {
          "details": "Adds a selector to the blacklist",
          "params": {
            "selector_": "the selector to add"
          }
        },
        "decodeAmountIn(bytes,bool)": {
          "details": "decodes the txData and returns the amount of input token on source",
          "params": {
            "genericSwapDisallowed_": "true if generic swaps are disallowed",
            "txData_": "is the txData of the cross chain deposit"
          },
          "returns": {
            "amount_": "the amount expected"
          }
        },
        "decodeDstSwap(bytes)": {
          "details": "decodes neccesary information for processing swaps on the destination chain",
          "params": {
            "txData_": "is the txData to be decoded"
          },
          "returns": {
            "amount_": "the amount expected",
            "token_": "is the address of the token"
          }
        },
        "decodeSwapOutputToken(bytes)": {
          "details": "decodes the final output token address (for only direct chain actions!)",
          "params": {
            "txData_": "is the txData to be decoded"
          },
          "returns": {
            "token_": "the address of the token"
          }
        },
        "extractGenericSwapParameters(bytes)": {
          "params": {
            "data_": "The calldata to extract the generic swap parameters from"
          },
          "returns": {
            "amount": "The amount extracted from the calldata",
            "receiver": "The receiver extracted from the calldata",
            "receivingAmount": "The receiving amount extracted from the calldata",
            "receivingAssetId": "The receiving asset id extracted from the calldata",
            "sendingAssetId": "The sending asset id extracted from the calldata"
          }
        },
        "extractMainParameters(bytes)": {
          "params": {
            "data_": "The calldata to extract the main parameters from"
          },
          "returns": {
            "amount": "The amount the calldata (which may be equal to bridge min amount)",
            "bridge": "The bridge extracted from the calldata",
            "destinationChainId": "The destination chain id extracted from the calldata",
            "hasDestinationCall": "Whether the calldata has a destination call",
            "hasSourceSwaps": "Whether the calldata has source swaps",
            "minAmount": "The min amount extracted from the bridgeData calldata",
            "receiver": "The receiver extracted from the calldata",
            "sendingAssetId": "The sending asset id extracted from the calldata"
          }
        },
        "isSelectorBlacklisted(bytes4)": {
          "details": "Checks if given selector is blacklisted",
          "params": {
            "selector_": "the selector to check"
          },
          "returns": {
            "blacklisted": "if selector is blacklisted"
          }
        },
        "removeFromBlacklist(bytes4)": {
          "details": "Removes a selector from the blacklist",
          "params": {
            "selector_": "the selector to remove"
          }
        },
        "validateReceiver(bytes,address)": {
          "details": "validates the receiver of the liquidity request",
          "params": {
            "receiver_": "is the address of the receiver to validate",
            "txData_": "is the txData of the cross chain deposit"
          },
          "returns": {
            "valid_": "if the address is valid"
          }
        },
        "validateTxData((bytes,uint64,uint64,uint64,bool,address,address,address,address))": {
          "details": "validates the txData of a cross chain deposit",
          "params": {
            "args_": "the txData arguments to validate in txData"
          },
          "returns": {
            "hasDstSwap": "if the txData contains a destination swap"
          }
        }
      },
      "stateVariables": {
        "blacklistedSelectors": {
          "details": "mapping to store the blacklisted selectors"
        }
      },
      "title": "LiFiValidator",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "extractGenericSwapParameters(bytes)": {
          "notice": "Extracts the generic swap parameters from the calldata"
        },
        "extractMainParameters(bytes)": {
          "notice": "Extracts the main parameters from the calldata"
        }
      },
      "version": 1
    }
  },
