    "devdoc": {
      "kind": "dev",
      "methods": {
        "executeAction(bytes,bytes32[],uint8[],bytes32[])": {
          "details": "Is called by the RecipeExecutor chaining actions together",
          "params": {
            "_callData": "Array of input values each value encoded as bytes",
            "_paramMapping": "Array that specifies how return and subscribed values are mapped in input",
            "_returnValues": "Returns values from actions before, which can be injected in inputs",
            "_subData": "Array of subscribed vales, replaces input values if specified"
          },
          "returns": {
            "_0": "Returns a bytes32 value through DSProxy, each actions implements what that value is"
          }
        },
        "executeActionDirect(bytes)": {
          "details": "Used to save gas when executing a single action directly"
        },
        "getAaveTokenPriceInETH(address)": {
          "details": "if price isn't found this returns 0"
        },
        "getAaveTokenPriceInUSD(address)": {
          "details": "if price isn't found this returns 0"
        },
        "getAaveV3TokenPriceInETH(address)": {
          "details": "if price isn't found this returns 0"
        },
        "getAddrForChainlinkOracle(address)": {
          "details": "chainlink uses different addresses for WBTC and ETHthere is only STETH price feed so we use that for WSTETH and handle later "
        },
        "getChainlinkPriceInETH(address)": {
          "details": "If there's no ETH price feed returns 0"
        },
        "getChainlinkPriceInUSD(address,bool)": {
          "details": "If there's no USD price feed can fallback to ETH price feed, if there's no USD or ETH price feed return 0"
        },
        "getPriceInETH(address)": {
          "details": "helper function that returns latest token price in USD1. Chainlink USD feed2. Chainlink ETH feed3. Aave feedif no price found return 0expect WBTC and WSTETH to have chainlink USD price"
        },
        "getPriceInUSD(address)": {
          "details": "helper function that returns latest token price in USD1. Chainlink USD feed2. Chainlink ETH feed3. Aave feedif no price found return 0"
        },
        "getRoundInfo(address,uint80)": {
          "details": "Helper function that returns chainlink price data",
          "params": {
            "_inputTokenAddr": "Token address we are looking the usd price for",
            "_roundId": "Chainlink roundId, if 0 uses the latest"
          }
        },
        "getRoundInfo(address,uint80,address)": {
          "details": "Helper function that returns chainlink price data",
          "params": {
            "_inputTokenAddr": "Token address we are looking the usd price for",
            "_roundId": "Chainlink roundId, if 0 uses the latest"
          }
        },
        "getSparkTokenPriceInETH(address)": {
          "details": "if price isn't found this returns 0"
        }
