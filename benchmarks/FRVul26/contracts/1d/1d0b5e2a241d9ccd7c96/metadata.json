    "devdoc": {
      "author": "Euler Labs (https://www.eulerlabs.com/)",
      "custom:security-contact": "security@euler.xyz",
      "events": {
        "ProxyCreated(address,bool,address,bytes)": {
          "params": {
            "implementation": "Address of the implementation contract, at the time the proxy was deployed",
            "proxy": "Address of the new proxy",
            "trailingData": "The metadata that will be attached to every call passing through the proxy",
            "upgradeable": "If true, proxy is an instance of the BeaconProxy. If false, the proxy is a minimal meta proxy"
          }
        },
        "SetImplementation(address)": {
          "params": {
            "newImplementation": "Address of the new implementation contract"
          }
        },
        "SetUpgradeAdmin(address)": {
          "params": {
            "newUpgradeAdmin": "Address of the new admin"
          }
        }
      },
      "kind": "dev",
      "methods": {
        "createProxy(address,bool,bytes)": {
          "details": "The desired implementation serves as a protection against (unintentional) front-running of upgrades",
          "params": {
            "desiredImplementation": "Address of the implementation contract expected to be registered in the factory during proxy creation",
            "trailingData": "Metadata to be attached to every call passing through the new proxy",
            "upgradeable": "If true, the proxy will be an instance of the BeaconProxy. If false, a minimal meta proxy will be deployed"
          },
          "returns": {
            "_0": "The address of the new proxy"
          }
        },
        "getProxyConfig(address)": {
          "params": {
            "proxy": "Address of the proxy to query"
          },
          "returns": {
            "config": "The proxy's configuration, including current implementation"
          }
        },
        "getProxyListLength()": {
          "returns": {
            "_0": "The length of the proxy list array"
          }
        },
        "getProxyListSlice(uint256,uint256)": {
          "params": {
            "end": "End index of the slice",
            "start": "Start index of the slice"
          },
          "returns": {
            "list": "An array containing the slice of the proxy list"
          }
        },
        "isProxy(address)": {
          "params": {
            "proxy": "Address to check"
          },
          "returns": {
            "_0": "True if the address is a proxy"
          }
        },
        "setImplementation(address)": {
          "details": "Upgrades all existing BeaconProxies to the new logic immediately",
          "params": {
            "newImplementation": "Address of the new implementation contract"
          }
        },
        "setUpgradeAdmin(address)": {
          "details": "For creating non upgradeable factories, or to finalize all upgradeable proxies to current implementation,set the admin to zero address.If setting to address zero, make sure the implementation contract is already set",
          "params": {
            "newUpgradeAdmin": "Address of the new admin"
          }
        }
      },
      "stateVariables": {
        "implementation": {
          "details": "The contract must implement the `IComponent` interface"
        }
      },
      "title": "GenericFactory",
      "version": 1
