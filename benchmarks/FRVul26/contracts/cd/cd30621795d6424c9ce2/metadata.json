    "devdoc": {
      "details": "XBridge is a smart contract that serves as the entrance for cross-chain operations, allowing users to interact with various functionalities such as bridging assets, swapping and bridging tokens, and claiming assets on the destination chain.",
      "events": {
        "Initialized(uint8)": {
          "details": "Triggered when the contract has been initialized or reinitialized."
        },
        "Paused(address)": {
          "details": "Emitted when the pause is triggered by `account`."
        },
        "Unpaused(address)": {
          "details": "Emitted when the pause is lifted by `account`."
        }
      },
      "kind": "dev",
      "methods": {
        "bridgeToV2((uint256,address,address,uint256,uint256,bytes,bytes))": {
          "params": {
            "_request": "The BridgeRequestV2 struct containing the details of the bridge operation."
          }
        },
        "claim((address,address,address,uint256,uint256,uint256,bytes32,bytes,bytes))": {
          "params": {
            "_request": "The SwapRequest struct containing details of the asset claiming operation."
          }
        },
        "constructor": {
          "custom:oz-upgrades-unsafe-allow": "constructor"
        },
        "doBatch((address,uint256,uint256,bytes32,bytes)[],(address,address,address,uint256,uint256,uint256,bytes32,bytes,bytes)[])": {
          "params": {
            "_claimRequest": "Array of SwapRequest structs containing details of asset claiming operations.",
            "_gasRequest": "Array of ReceiveGasRequest structs containing details of Gas Token receiving operations."
          }
        },
        "initialize()": {
          "details": "This function is part of the Upgradable pattern and is called once to initialize contract state. It sets up the initial state by invoking the initializers of the inherited contracts. The `admin` variable is set to the address of the account that deploys the contract. Note: This function is meant to be called only once during the contract deployment."
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "receiveGasToken((address,uint256,uint256,bytes32,bytes))": {
          "params": {
            "_request": "The ReceiveGasRequest struct containing the details of this operation."
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
        },
        "swapBridgeToV2((address,address,address,uint256,uint256,uint256,uint256,uint256,bytes,bytes,bytes))": {
          "params": {
            "_request": "The SwapBridgeRequestV2 struct containing the details of the swap and bridge operation."
          }
        },
        "swapBridgeToWithPermit((address,address,address,uint256,uint256,uint256,uint256,uint256,bytes,bytes,bytes),bytes)": {
          "params": {
            "_request": "The SwapBridgeRequestV2 struct containing the details of the swap and bridge operation.",
            "_signature": "The permit signature for the fromToken."
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        }
      },
      "stateVariables": {
        "approveProxy": {
          "details": "This state variable is deprecated and should not be used anymore."
        },
        "sysAddressConfig": {
          "details": "This state variable is deprecated and should not be used anymore."
        },
        "sysRatio": {
          "details": "Set by admin"
        }
      },
      "title": "XBridge",
      "version": 1
    },
    "userdoc": {
      "events": {
        "Claimed(address,address,address,uint256,uint256,uint256,uint256,string,bytes32[])": {
          "notice": "Event emitted when a claim transaction occurs"
        },
        "LogBridgeTo(uint256,address,address,address,uint256,uint256,bytes32[])": {
          "notice": "Event emitted when a bridge transaction occurs"
        },
        "LogSwapAndBridgeTo(uint256,address,address,address,uint256,address,uint256,uint256,bytes32[])": {
          "notice": "Event emitted when a swap and bridge transaction occurs"
        }
      },
      "kind": "user",
      "methods": {
        "bridgeToV2((uint256,address,address,uint256,uint256,bytes,bytes))": {
          "notice": "Initiates the bridge operation to transfer assets to another chain using the bridge."
        },
        "claim((address,address,address,uint256,uint256,uint256,bytes32,bytes,bytes))": {
          "notice": "Claims the assets on the current chain as part of the cross-chain swap."
        },
        "doBatch((address,uint256,uint256,bytes32,bytes)[],(address,address,address,uint256,uint256,uint256,bytes32,bytes,bytes)[])": {
          "notice": "Performs batch operations including Gas Token receiving and asset claiming."
        },
        "initialize()": {
          "notice": "Initializes the XBridge contract."
        },
        "receiveGasToken((address,uint256,uint256,bytes32,bytes))": {
          "notice": "Completed receiving gas tokens from the source chain."
        },
        "swapBridgeToV2((address,address,address,uint256,uint256,uint256,uint256,uint256,bytes,bytes,bytes))": {
          "notice": "Initiates a swap and bridge operation using the bridge."
        },
        "swapBridgeToWithPermit((address,address,address,uint256,uint256,uint256,uint256,uint256,bytes,bytes,bytes),bytes)": {
          "notice": "Initiates a swap and bridge operation with permit using V2 of the bridge."
        }
      },
      "notice": "Entrance for Bridge - Users can:   # Bridge: Initiate cross-chain asset transfers.   # Swap and bridge: Perform token swaps and initiate cross-chain transfers.",
      "version": 1
    }
