      "methods": {
        "getTradeCalldata(address,uint256,address,uint256,address,uint256,bytes)": {
          "params": {
            "_data": "Arbitrary call data which is sent to the exchange",
            "_from": "Address of the token to sell",
            "_fromAmount": "Amount of the token to sell",
            "_minToReceive": "Minimal amount to receive",
            "_taker": "Taker of the received value",
            "_to": "Address of the token that will be received",
            "_value": "ETH value for this trade"
          },
          "returns": {
            "_0": "address       Calldata handler contract address",
            "_1": "uint256       Call value",
            "_2": "bytes         Trade calldata"
