    "devdoc": {
      "events": {
        "Approval(address,address,uint256)": {
          "details": "Emitted when the allowance of a `spender` for an `owner` is set by a call to {approve}. `value` is the new allowance."
        },
        "RewardsClaimed(address,uint256)": {
          "params": {
            "amount": "{qTok}",
            "erc20": "The ERC20 of the reward token"
          }
        },
        "Transfer(address,address,uint256)": {
          "details": "Emitted when `value` tokens are moved from one account (`from`) to another (`to`). Note that `value` may be zero."
        }
      },
      "kind": "dev",
      "methods": {
        "accrueAccount(address)": {
          "params": {
            "account": "The address to accrue, first in cUSDCv3, then locally"
          }
        },
        "allow(address,bool)": {
          "details": "Allow or disallow another address to withdraw, or transfer from the sender. Emits an {Approval} event. Requirements: - `owner` cannot be the zero address. - `manager` cannot be the zero address."
        },
        "allowance(address,address)": {
          "details": "See {IERC20-allowance}."
        },
        "approve(address,uint256)": {
          "details": "See {IERC20-approve}. NOTE: If `amount` is the maximum `uint256`, the allowance is not updated on `transferFrom`. This is semantically equivalent to an infinite approval. Requirements: - `spender` cannot be the zero address."
        },
        "balanceOf(address)": {
          "details": "See {IERC20-balanceOf}."
        },
        "claimTo(address,address)": {
          "params": {
            "dst": "The address to send claimed rewards to",
            "src": "The account to claim from"
          }
        },
        "convertDynamicToStatic(uint256)": {
          "params": {
            "amount": "The value of {Comet} to convert to {wComet}"
          },
          "returns": {
            "_0": "{wComet} The amount of wrapped token represented by `amount` of {Comet}"
          }
        },
        "convertStaticToDynamic(uint104)": {
          "params": {
            "amount": "The value of {wComet} to convert to {Comet}"
          },
          "returns": {
            "_0": "{Comet} The amount of cUSDCv3 represented by `amount of {wComet}"
          }
        },
        "decimals()": {
          "returns": {
            "_0": "number of decimals"
          }
        },
        "deposit(uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to deposit"
          }
        },
        "depositFrom(address,address,uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to deposit",
            "dst": "The address to deposit to",
            "src": "The address to deposit from"
          }
        },
        "depositTo(address,uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to deposit",
            "dst": "The dst to deposit into"
          }
        },
        "exchangeRate()": {
          "returns": {
            "_0": "The exchange rate {comet/wComet}"
          }
        },
        "getRewardOwed(address)": {
          "params": {
            "account": "The address to view the owed rewards of"
          },
          "returns": {
            "_0": "{reward} The amount of reward tokens owed to `account`"
          }
        },
        "hasPermission(address,address)": {
          "details": "Determine if the `manager` has permission to act on behalf of the `owner`."
        },
        "name()": {
          "details": "Returns the name of the token."
        },
        "symbol()": {
          "details": "Returns the symbol of the token, usually a shorter version of the name."
        },
        "totalSupply()": {
          "details": "See {IERC20-totalSupply}."
        },
        "transfer(address,uint256)": {
          "details": "See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `amount`."
        },
        "transferFrom(address,address,uint256)": {
          "details": "See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `amount`. - the caller must be authorized to transfer ``from``'s tokens"
        },
        "underlyingBalanceOf(address)": {
          "params": {
            "account": "The address to calculate the cUSDCv3 balance of"
          },
          "returns": {
            "_0": "{Comet} The cUSDCv3 balance that `account` holds in the wrapper"
          }
        },
        "withdraw(uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to withdraw"
          }
        },
        "withdrawFrom(address,address,uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to withdraw",
            "dst": "The address to withdraw cUSDCv3 to",
            "src": "The address to withdraw from"
          }
        },
        "withdrawTo(address,uint256)": {
          "params": {
            "amount": "{Comet} The amount of cUSDCv3 to withdraw",
            "dst": "The address to withdraw cUSDCv3 to"
          }
        }
      },
      "title": "CusdcV3Wrapper",
      "version": 1
    },
    "userdoc": {
      "events": {
        "RewardsClaimed(address,uint256)": {
          "notice": "Emitted whenever a reward token balance is claimed"
        }
      },
      "kind": "user",
      "methods": {
        "RESCALE_FACTOR()": {
          "notice": "From cUSDCv3, scaling factor for USDC rewards"
        },
        "TRACKING_INDEX_SCALE()": {
          "notice": "From cUSDCv3, used in principal <> present calculations"
        },
        "accrue()": {
          "notice": "Accure the cUSDCv3 account of the wrapper"
        },
        "claimRewards()": {
          "notice": "Claim rewards earned by holding a balance of the ERC20 token Must emit `RewardsClaimed` for each token rewards are claimed for"
        },
        "underlyingBalanceOf(address)": {
          "notice": "Get the balance of cUSDCv3 that is represented by the `accounts` wrapper value."
        }
      },
      "notice": "Wrapper for cUSDCV3 / COMET that acts as a stable-balance ERC20, instead of rebasing token. {comet} will be used as the unit for the underlying token, and {wComet} will be used as the unit for wrapped tokens.",
      "version": 1
    }
