    "devdoc": {
      "methods": {
        "claimAdmin()": {
          "details": "Allows the pendingAdmin address to finalize the change admin process.\r"
        },
        "getBalance(address,address)": {
          "details": "get the balance of a user.\r",
          "params": {
            "token": "The token type\r"
          },
          "return": "The balance\r"
        },
        "swapEtherToToken(address,uint256)": {
          "details": "makes a trade from Ether to token. Sends token to msg sender\r",
          "params": {
            "minConversionRate": "The minimal conversion rate. If actual rate is lower, trade is canceled.\r",
            "token": "Destination token\r"
          },
          "return": "amount of actual dest tokens\r"
        },
        "swapTokenToEther(address,uint256,uint256)": {
          "details": "makes a trade from token to Ether, sends Ether to msg sender\r",
          "params": {
            "minConversionRate": "The minimal conversion rate. If actual rate is lower, trade is canceled.\r",
            "srcAmount": "amount of src tokens\r",
            "token": "Src token\r"
          },
          "return": "amount of actual dest tokens\r"
        },
        "swapTokenToToken(address,uint256,address,uint256)": {
          "details": "makes a trade between src and dest token and send dest tokens to msg sender\r",
          "params": {
            "dest": "Destination token\r",
            "minConversionRate": "The minimal conversion rate. If actual rate is lower, trade is canceled.\r",
            "src": "Src token\r",
            "srcAmount": "amount of src tokens\r"
          },
          "return": "amount of actual dest tokens\r"
        },
        "trade(address,uint256,address,address,uint256,uint256,address)": {
          "details": "makes a trade between src and dest token and send dest token to destAddress\r",
          "params": {
            "dest": "Destination token\r",
            "destAddress": "Address to send tokens to\r",
            "maxDestAmount": "A limit on the amount of dest tokens\r",
            "minConversionRate": "The minimal conversion rate. If actual rate is lower, trade is canceled.\r",
            "src": "Src token\r",
            "srcAmount": "amount of src tokens\r",
            "walletId": "is the wallet ID to send part of the fees\r"
          },
          "return": "amount of actual dest tokens\r"
        },
        "tradeWithHint(address,uint256,address,address,uint256,uint256,address,bytes)": {
          "details": "makes a trade between src and dest token and send dest token to destAddress\r",
          "params": {
            "dest": "Destination token\r",
            "destAddress": "Address to send tokens to\r",
            "hint": "will give hints for the trade.\r",
            "maxDestAmount": "A limit on the amount of dest tokens\r",
            "minConversionRate": "The minimal conversion rate. If actual rate is lower, trade is canceled.\r",
            "src": "Src token\r",
            "srcAmount": "amount of src tokens\r",
            "walletId": "is the wallet ID to send part of the fees\r"
          },
          "return": "amount of actual dest tokens\r"
        },
        "transferAdmin(address)": {
          "details": "Allows the current admin to set the pendingAdmin address.\r",
          "params": {
            "newAdmin": "The address to transfer ownership to.\r"
          }
        },
        "transferAdminQuickly(address)": {
          "details": "Allows the current admin to set the admin in one tx. Useful initial deployment.\r",
          "params": {
            "newAdmin": "The address to transfer ownership to.\r"
          }
        },
        "withdrawEther(uint256,address)": {
          "details": "Withdraw Ethers\r"
        },
        "withdrawToken(address,uint256,address)": {
          "details": "Withdraw all ERC20 compatible tokens\r",
          "params": {
            "token": "ERC20 The address of the token contract\r"
          }
        }
      },
      "title": "Kyber Network proxy for main contract\r"
    },
    "userdoc": {
      "methods": {
        "trade(address,uint256,address,address,uint256,uint256,address)": {
          "notice": "use token address ETH_TOKEN_ADDRESS for ether\r"
        },
        "tradeWithHint(address,uint256,address,address,uint256,uint256,address,bytes)": {
          "notice": "use token address ETH_TOKEN_ADDRESS for ether\r"
        }
      }
    }
