    "devdoc": {
      "details": "This contract is owned by RMN, if changing, please notify the RMN maintainers.",
      "kind": "dev",
      "methods": {
        "getBlessProgress((address,bytes32))": {
          "details": "This is a helper method for offchain code so efficiency is not really a concern.",
          "returns": {
            "accumulatedWeight": "sum of weights of voters, will be zero if voting took place with an older config version",
            "blessVoteAddrs": "addresses of voters, will be empty if voting took place with an older config version",
            "blessed": "will be accurate regardless of when voting took place"
          }
        },
        "getCurseProgress(bytes16)": {
          "details": "This is a helper method for offchain code so efficiency is not really a concern.",
          "returns": {
            "accumulatedWeight": "the accumulated weight of all voters with an active vote to curse who are part of the current config",
            "curseVoteAddrs": "the curseVoteAddr of each voter with an active vote to curse",
            "cursed": "might be true even if the owner has no active vote and accumulatedWeight < curseWeightThreshold, due to a retained curse from a prior config",
            "cursesHashes": "the i-th value is the curses hash of curseVoteAddrs[i]"
          }
        },
        "getRecordedCurseRelatedOps(uint256,uint256)": {
          "details": "This is a helper method for offchain code so efficiency is not really a concern.Returns s_recordedCurseRelatedOps[offset:offset+limit]."
        },
        "getRecordedCurseRelatedOpsCount()": {
          "details": "This is a helper method for offchain code to know what arguments to use for getRecordedCurseRelatedOps."
        },
        "isCursed(bytes16)": {
          "params": {
            "subject": "To check whether a particular chain is cursed, set to bytes16(uint128(chainSelector))."
          }
        },
        "voteToBless((address,bytes32)[])": {
          "params": {
            "taggedRoots": "A tagged root is hashed as `keccak256(abi.encode(taggedRoot.commitStore /* address */, taggedRoot.root /* bytes32 */))`."
          }
        }
      },
      "version": 1
    },
    "userdoc": {
      "errors": {
        "SubjectsMustBeStrictlyIncreasing()": [
          {
            "notice": "Thrown when subjects are not a strictly increasing monotone sequence."
          }
        ]
      },
      "kind": "user",
      "methods": {
        "acceptOwnership()": {
          "notice": "Allows an ownership transfer to be completed by the recipient."
        },
        "getConfigDetails()": {
          "notice": "Config version might be incremented for many reasons, including the lifting of a curse, or a regular config change."
        },
        "getCursedSubjectsCount()": {
          "notice": "Returns the number of subjects that are currently cursed."
        },
        "getPermaBlessedCommitStores()": {
          "notice": "Any tagged root with a commit store included in this array will be considered automatically blessed."
        },
        "isBlessed((address,bytes32))": {
          "notice": "Callers MUST NOT cache the return value as a blessed tagged root could become unblessed."
        },
        "isCursed()": {
          "notice": "Iff there is an active global or legacy curse, this function returns true."
        },
        "isCursed(bytes16)": {
          "notice": "Iff there is an active global curse, or an active curse for `subject`, this function returns true."
        },
        "owner()": {
          "notice": "Get the current owner"
        },
        "ownerCurse(bytes16,bytes16[])": {
          "notice": "Enables the owner to immediately have the system enter the cursed state."
        },
        "ownerRemoveThenAddPermaBlessedCommitStores(address[],address[])": {
          "notice": "The ordering of parameters is important. First come the commit stores to remove, then the commit stores to add."
        },
        "ownerResetBlessVotes((address,bytes32)[])": {
          "notice": "Can be called by the owner to remove unintentionally voted or even blessed tagged roots in a recovery scenario. The owner must ensure that there are no in-flight transactions by RMN nodes voting for any of the taggedRoots before calling this function, as such in-flight transactions could lead to the roots becoming re-blessed shortly after the call to this function, contrary to the original intention."
        },
        "ownerUnvoteToCurse((address,(bytes16,bytes28),bool)[])": {
          "notice": "Enables the owner to remove curse votes. After the curse votes are removed, this function will check whether the curse is still valid and restore the uncursed state if possible. This function also enables the owner to lift a curse created through ownerCurse."
        },
        "transferOwnership(address)": {
          "notice": "Allows an owner to begin transferring ownership to a new address."
        },
        "unvoteToCurse((bytes16,bytes28)[])": {
          "notice": "Can be called by a curser to remove unintentional votes to curse. We expect this to be called very rarely, e.g. in case of a bug in the offchain code causing false voteToCurse calls.Should be called from curser's corresponding curseVoteAddr."
        },
        "voteToBless((address,bytes32)[])": {
          "notice": "Tagged roots which are already (voted to be) blessed are skipped and emit corresponding events. In case the call has no effect, i.e., all passed tagged roots are skipped, the function reverts with a `VoteToBlessNoop`."
        },
        "voteToCurse(bytes16,bytes16[])": {
          "notice": "A vote to curse is appropriate during unhealthy blockchain conditions (eg. finality violations)."
        }
      },
      "version": 1
    }
  },
