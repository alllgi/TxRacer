    "devdoc": {
      "details": "Maintains registry of local mintable tokens and corresponding tokens on remote domains. This registry can be used by caller to determine which token on local domain to mint for a burned token on a remote domain, and vice versa. It is assumed that local and remote tokens are fungible at a constant 1:1 exchange rate.",
      "events": {
        "LocalTokenMessengerAdded(address)": {
          "params": {
            "localTokenMessenger": "address of local TokenMessenger"
          }
        },
        "LocalTokenMessengerRemoved(address)": {
          "params": {
            "localTokenMessenger": "address of local TokenMessenger"
          }
        }
      },
      "kind": "dev",
      "methods": {
        "acceptOwnership()": {
          "details": "The new owner accepts the ownership transfer."
        },
        "addLocalTokenMessenger(address)": {
          "details": "Reverts if a TokenMessenger is already set for the local domain.",
          "params": {
            "newLocalTokenMessenger": "The address of the new TokenMessenger on the local domain."
          }
        },
        "burn(address,uint256)": {
          "params": {
            "burnAmount": "amount of tokens to burn. Must be > 0, and <= maximum burn amount per message.",
            "burnToken": "burnable token address."
          }
        },
        "constructor": {
          "params": {
            "_tokenController": "Token controller address"
          }
        },
        "getLocalToken(uint32,bytes32)": {
          "params": {
            "remoteDomain": "Remote domain",
            "remoteToken": "Remote token"
          },
          "returns": {
            "_0": "local token address"
          }
        },
        "linkTokenPair(address,uint32,bytes32)": {
          "details": "Associates a (`remoteToken`, `localToken`) pair by updating remoteTokensToLocalTokens mapping. Reverts if the remote token (for the given `remoteDomain`) already maps to a nonzero local token. Note: - A remote token (on a certain remote domain) can only map to one local token, but many remote tokens can map to the same local token. - Setting a token pair does not enable the `localToken` (that requires calling setLocalTokenEnabledStatus.)"
        },
        "mint(uint32,bytes32,address,uint256)": {
          "details": "reverts if the (`sourceDomain`, `burnToken`) pair does not map to a nonzero local token address. This mapping can be queried using getLocalToken().",
          "params": {
            "amount": "Amount of tokens to mint. Must be less than or equal to the minterAllowance of this TokenMinter for given `_mintToken`.",
            "burnToken": "Burned token address as bytes32.",
            "sourceDomain": "Source domain where `burnToken` was burned.",
            "to": "Address to receive minted tokens, corresponding to `burnToken`, on this domain."
          },
          "returns": {
            "mintToken": "token minted."
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "pause()": {
          "details": "called by the owner to pause, triggers stopped state"
        },
        "pauser()": {
          "returns": {
            "_0": "Pauser's address"
          }
        },
        "pendingOwner()": {
          "details": "Returns the address of the pending owner."
        },
        "removeLocalTokenMessenger()": {
          "details": "Reverts if the TokenMessenger of the local domain is not set."
        },
        "rescueERC20(address,address,uint256)": {
          "params": {
            "amount": "Amount to withdraw",
            "to": "Recipient address",
            "tokenContract": "ERC20 token contract address"
          }
        },
        "rescuer()": {
          "returns": {
            "_0": "Rescuer's address"
          }
        },
        "setMaxBurnAmountPerMessage(address,uint256)": {
          "details": "Burns with amounts exceeding `burnLimitPerMessage` will revert. Mints do not respect this value, so if this limit is reduced, previously burned tokens will still be mintable.",
          "params": {
            "burnLimitPerMessage": "Maximum burn amount per message to set.",
            "localToken": "Local token to set the maximum burn amount per message of."
          }
        },
        "setTokenController(address)": {
          "details": "newTokenController must be nonzero.",
          "params": {
            "newTokenController": "address of new token controller"
          }
        },
        "tokenController()": {
          "details": "Returns the address of the tokenController",
          "returns": {
            "_0": "address of the tokenController"
          }
        },
        "transferOwnership(address)": {
          "details": "Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner."
        },
        "unlinkTokenPair(address,uint32,bytes32)": {
          "details": "Removes link from `remoteToken`, to `localToken` for given `remoteDomain` by updating remoteTokensToLocalTokens mapping. Reverts if the remote token (for the given `remoteDomain`) already maps to the zero address. Note: - A remote token (on a certain remote domain) can only map to one local token, but many remote tokens can map to the same local token. - Unlinking a token pair does not disable burning the `localToken` (that requires calling setMaxBurnAmountPerMessage.)"
        },
        "unpause()": {
          "details": "called by the owner to unpause, returns to normal state"
        },
        "updatePauser(address)": {
          "details": "update the pauser role"
        },
        "updateRescuer(address)": {
          "params": {
            "newRescuer": "New rescuer's address"
          }
        }
      },
      "title": "TokenMinter",
      "version": 1
    },
    "userdoc": {
      "events": {
        "LocalTokenMessengerAdded(address)": {
          "notice": "Emitted when a local TokenMessenger is addedEmitted when a local TokenMessenger is added"
        },
        "LocalTokenMessengerRemoved(address)": {
          "notice": "Emitted when a local TokenMessenger is removedEmitted when a local TokenMessenger is removed"
        },
        "SetBurnLimitPerMessage(address,uint256)": {
          "notice": "Emitted when a burn limit per message is set for a particular token"
        },
        "SetTokenController(address)": {
          "notice": "Emitted when token controller is set"
        },
        "TokenPairLinked(address,uint32,bytes32)": {
          "notice": "Emitted when a token pair is linked"
        },
        "TokenPairUnlinked(address,uint32,bytes32)": {
          "notice": "Emitted when a token pair is unlinked"
        }
      },
      "kind": "user",
      "methods": {
        "addLocalTokenMessenger(address)": {
          "notice": "Add TokenMessenger for the local domain. Only this TokenMessenger has permission to call mint() and burn() on this TokenMinter."
        },
        "burn(address,uint256)": {
          "notice": "Burn tokens owned by this TokenMinter."
        },
        "getLocalToken(uint32,bytes32)": {
          "notice": "Get the local token address associated with the given remote domain and token."
        },
        "linkTokenPair(address,uint32,bytes32)": {
          "notice": "Links a pair of local and remote tokens to be supported by this TokenMinter."
        },
        "mint(uint32,bytes32,address,uint256)": {
          "notice": "Mints `amount` of local tokens corresponding to the given (`sourceDomain`, `burnToken`) pair, to `to` address."
        },
        "pauser()": {
          "notice": "Returns current pauser"
        },
        "removeLocalTokenMessenger()": {
          "notice": "Remove the TokenMessenger for the local domain."
        },
        "rescueERC20(address,address,uint256)": {
          "notice": "Rescue ERC20 tokens locked up in this contract."
        },
        "rescuer()": {
          "notice": "Returns current rescuer"
        },
        "setMaxBurnAmountPerMessage(address,uint256)": {
          "notice": "Sets the maximum burn amount per message for a given `localToken`."
        },
        "setTokenController(address)": {
          "notice": "Set tokenController to `newTokenController`, and emit `SetTokenController` event."
        },
        "unlinkTokenPair(address,uint32,bytes32)": {
          "notice": "Unlinks a pair of local and remote tokens for this TokenMinter."
        },
        "updateRescuer(address)": {
          "notice": "Assign the rescuer role to a given address."
        }
      },
      "notice": "Token Minter and Burner",
      "version": 1
    }
