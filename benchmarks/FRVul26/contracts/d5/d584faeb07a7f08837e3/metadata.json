    "devdoc": {
      "author": "kexley, Beefy, SoulSoulidity",
      "details": "Router that allows arbitary calls to external contracts. Users can zap directly or sign using Permit2 to allow a relayer to execute zaps on their behalf. Do not directly approve this contract for spending your tokens, approve the TokenManager instead",
      "events": {
        "FulfilledOrder(((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),address,address)": {
          "params": {
            "caller": "Address of the order's executor",
            "order": "Order that has been fulfilled",
            "recipient": "Address of the order's recipient"
          }
        },
        "Paused(address)": {
          "details": "Emitted when the pause is triggered by `account`."
        },
        "RelayData(address,uint256,bytes)": {
          "params": {
            "data": "Payload of the external call",
            "target": "Address of the target",
            "value": "Ether value of the call"
          }
        },
        "TokenReturned(address,uint256)": {
          "params": {
            "amount": "Amount of the token sent to the recipient",
            "token": "Address of the token sent to recipient"
          }
        },
        "Unpaused(address)": {
          "details": "Emitted when the pause is lifted by `account`."
        }
      },
      "kind": "dev",
      "methods": {
        "constructor": {
          "details": "Initialize permit2 address and create an implementation of the token manager",
          "params": {
            "_permit2": "Address for the permit2 contract"
          }
        },
        "executeOrder(((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),(address,uint256,bytes,(address,int32)[])[])": {
          "details": "The user executes their own order directly. User must have already approved the token manager to move the tokens",
          "params": {
            "_order": "Order containing how many tokens to pull and the slippage amounts on outputs",
            "_route": "Route containing the steps to reach the output"
          }
        },
        "executeOrder(((address,uint256)[],uint256,uint256),((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),bytes,(address,uint256,bytes,(address,int32)[])[])": {
          "details": "Execute an order indirectly by passing a signed permit from Permit2 that contains the order as witness data. The user who owns the tokens must have already approved Permit2. Route is supplied at this stage as slippages and amounts are already set in the signed order",
          "params": {
            "_order": "Order that details the input/output tokens and amounts",
            "_permit": "Struct of tokens that have been permitted and the nonce/deadline",
            "_route": "Actual steps that will transform input tokens to output tokens",
            "_signature": "Resulting string from signing the permit and order data"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "pause()": {
          "details": "Only owner can pause"
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "unpause()": {
          "details": "Only owner can unpause"
        }
      },
      "stateVariables": {
        "ORDER_STRING": {
          "details": "Witness string used in signing an order"
        },
        "ORDER_TYPEHASH": {
          "details": "Witness typehash used in signing an order"
        }
      },
      "title": "Zap router for Soul vaults",
      "version": 1
    },
    "userdoc": {
      "events": {
        "FulfilledOrder(((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),address,address)": {
          "notice": "Completed order"
        },
        "RelayData(address,uint256,bytes)": {
          "notice": "External relay call at end of zap"
        },
        "TokenReturned(address,uint256)": {
          "notice": "Token and amount sent to the recipient at end of a zap"
        }
      },
      "kind": "user",
      "methods": {
        "executeOrder(((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),(address,uint256,bytes,(address,int32)[])[])": {
          "notice": "Execute an order directly"
        },
        "executeOrder(((address,uint256)[],uint256,uint256),((address,uint256)[],(address,uint256)[],(address,uint256,bytes),address,address),bytes,(address,uint256,bytes,(address,int32)[])[])": {
          "notice": "Execute an order using a signature from the input token owner"
        },
        "pause()": {
          "notice": "Pause the contract from carrying out any more zaps"
        },
        "permit2()": {
          "notice": "Permit2 immutable address"
        },
        "tokenManager()": {
          "notice": "Token manager immutable address"
        },
        "unpause()": {
          "notice": "Unpause the contract to allow new zaps"
        }
      },
      "notice": "Adaptable router for zapping tokens to and from Soul vaults",
      "version": 1
    }
