          "params": {
            "conicLpAmount": "Amount of LP tokens to burn",
            "minUnderlyingReceived": "Minimum amount of underlying to redeem This should always be set to a reasonable value (e.g. 2%), otherwise the user withdrawing could be forced into paying a withdrawal penalty fee by another user"
          },
          "returns": {
            "_0": "uint256 Total underlying withdrawn"
          }
        },
        "usdExchangeRate()": {
          "details": "This is using the cached total underlying value, so is not precisely accurate."
        },
        "withdraw(uint256,uint256)": {
          "params": {
            "conicLpAmount": "Amount of LP tokens to burn",
            "minUnderlyingReceived": "Minimum amount of underlying to redeem This should always be set to a reasonable value (e.g. 2%), otherwise the user withdrawing could be forced into paying a withdrawal penalty fee by another user"
          },
          "returns": {
            "_0": "uint256 Total underlying withdrawn"
          }
        }
      },
      "stateVariables": {
        "maxDeviation": {
          "details": "once the deviation gets under this threshold, the reward distribution will be paused until the next rebalancing. This is expressed as a ratio, scaled with 18 decimals"
        },
        "rebalancingRewardActive": {
          "details": "`true` while the reward distribution is active"
        },
        "totalDeviationAfterWeightUpdate": {
          "details": "the absolute value in terms of USD of the total deviation after the weights have been updated"
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "cachedTotalUnderlying()": {
          "notice": "same as `totalUnderlying` but returns a cached version that might be slightly outdated if oracle prices have changed"
        },
        "deposit(uint256,uint256)": {
          "notice": "Deposit underlying"
        },
        "deposit(uint256,uint256,bool)": {
          "notice": "Deposit underlying"
        },
        "depositFor(address,uint256,uint256,bool)": {
          "notice": "Deposit underlying on behalf of someone"
        },
        "exchangeRate()": {
          "notice": "Get current exchange rate for the pool's LP token to the underlying"
        },
        "handleDepeggedCurvePool(address)": {
          "notice": "Called when an underlying of a Curve Pool has depegged and we want to exit the pool. Will check if a coin has depegged, and will revert if not. Sets the weight of the Curve Pool to 0, and re-enables CNC rewards for deposits."
        },
        "handleInvalidConvexPid(address)": {
          "notice": "Allows anyone to set the weight of a Curve pool to 0 if the Convex pool for the associated PID has been shutdown. This is a very unilkely outcomu and the method does not reenable rebalancing rewards."
        },
        "totalUnderlying()": {
          "notice": "Get current underlying balance of pool"
        },
        "unstakeAndWithdraw(uint256,uint256)": {
          "notice": "Unstake LP Tokens and withdraw underlying"
        },
        "usdExchangeRate()": {
          "notice": "Get current exchange rate for the pool's LP token to USD"
        },
        "withdraw(uint256,uint256)": {
          "notice": "Withdraw underlying"
        }
      },
      "version": 1
    }
  },
