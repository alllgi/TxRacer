    "devdoc": {
      "author": "Euler Labs (https://www.eulerlabs.com/)",
      "custom:security-contact": "security@euler.xyz",
      "kind": "dev",
      "methods": {
        "deposit(address,address,uint256,address)": {
          "details": "Use amountMin to ignore dust",
          "params": {
            "account": "Receiver of the repay",
            "amountMin": "A minimum amount of tokens to deposit. If unavailable, the operation is a no-op",
            "token": "Asset to deposit",
            "vault": "Vault to deposit the token to"
          }
        },
        "multicall(bytes[])": {
          "details": "Calls itself with regular external calls",
          "params": {
            "calls": "Array of encoded payloads"
          }
        },
        "repay(address,address,uint256,address)": {
          "details": "in case of over-swapping to repay, pass max uint amount",
          "params": {
            "account": "Receiver of the repay",
            "repayAmount": "Amount of debt to repay",
            "token": "The asset that is borrowed",
            "vault": "The lending vault where the debt is tracked"
          }
        },
        "repayAndDeposit(address,address,uint256,address)": {
          "details": "If contract's balance is lower than requested repay amount, repay only the balance",
          "params": {
            "account": "Receiver of the repay",
            "repayAmount": "Amount of debt to repay",
            "token": "The asset that is borrowed",
            "vault": "The lending vault where the debt is tracked"
          }
        },
        "swap((bytes32,uint256,address,address,address,address,address,address,uint256,bytes))": {
          "params": {
            "params": "Configuration of the swap"
          }
        },
        "sweep(address,uint256,address)": {
          "params": {
            "amountMin": "Minimum amount of tokens to transfer. If unavailable, the operation is a no-op",
            "to": "Address to send the tokens to",
            "token": "Token to transfer"
          }
        }
      },
      "title": "Swapper",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "deposit(address,address,uint256,address)": {
          "notice": "Use all of the contract's token balance to execute a deposit for an account"
        },
        "multicall(bytes[])": {
          "notice": "Call multiple functions of the contract"
        },
        "repay(address,address,uint256,address)": {
          "notice": "Use the contract's token balance to repay debt of the account in a lending vault"
        },
        "repayAndDeposit(address,address,uint256,address)": {
          "notice": "Use the contract's token balance to repay debt of the account in a lending vault and deposit any remaining balance for the account in that same vault"
        },
        "swap((bytes32,uint256,address,address,address,address,address,address,uint256,bytes))": {
          "notice": "Execute a swap (and possibly repay or deposit) according to the SwapParams configuration"
        },
        "sweep(address,uint256,address)": {
          "notice": "Transfer all tokens held by the contract"
        }
      },
      "notice": "Untrusted helper contract for EVK for performing swaps and swaps to repay",
      "version": 1
    }
