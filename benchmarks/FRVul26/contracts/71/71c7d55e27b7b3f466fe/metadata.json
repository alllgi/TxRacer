    "devdoc": {
      "kind": "dev",
      "methods": {
        "bridge(string,address,uint256,bytes)": {
          "details": "pausable and nonreentrant",
          "params": {
            "adapterId": "Identifier of the aggregator to be used for the bridge",
            "amount": "Amount of tokens to be transferred from the destination chain",
            "data": "Dynamic data which is passed in to the delegatecall made to the adapter",
            "srcToken": "Identifier of the source chain"
          }
        },
        "constructor": {
          "details": "Deploys the Spender. Once the Spender is deployed it cannot be changed",
          "params": {
            "_owner": "The Owner of the MetaBridge set on deployment"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "paused()": {
          "details": "Returns true if the contract is paused, and false otherwise."
        },
        "removeAdapter(string)": {
          "params": {
            "adapterId": "Adapter's identifier"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
        },
        "setAdapter(string,address)": {
          "params": {
            "adapterAddress": "Address of the contract that contains the logic for this aggregator",
            "adapterId": "Aggregator's identifier"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "bridge(string,address,uint256,bytes)": {
          "notice": "Performs a bridge"
        },
        "constructor": {
          "notice": "Constructor to create the MetaBridge"
        },
        "pauseBridge()": {
          "notice": "Prevents the bridge function from being executed until the contract is unpaused."
        },
        "removeAdapter(string)": {
          "notice": "Removes the adapter for an existing aggregator. This can't be undone."
        },
        "setAdapter(string,address)": {
          "notice": "Sets the adapter for an aggregator. It can't be changed later."
        },
        "unpauseBridge()": {
          "notice": "Unpauses the contract to make the bridge function callable."
        }
      },
