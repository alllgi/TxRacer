    "devdoc": {
      "events": {
        "Approval(address,address,uint256)": {
          "details": "Emitted when the allowance of a `spender` for an `owner` is set by a call to {approve}. `value` is the new allowance."
        },
        "Transfer(address,address,uint256)": {
          "details": "Emitted when `value` tokens are moved from one account (`from`) to another (`to`). Note that `value` may be zero."
        }
      },
      "kind": "dev",
      "methods": {
        "allowance(address,address)": {
          "details": "See {IERC20-allowance}."
        },
        "approve(address,uint256)": {
          "details": "See {IERC20-approve}. Requirements: - `spender` cannot be the zero address."
        },
        "balanceOf(address)": {
          "details": "See {IERC20-balanceOf}."
        },
        "changeLimitTxMax(uint256)": {
          "details": "onlyOwner. Emits an {MaxTxUpdated} event",
          "params": {
            "_maxTx": "Base 1000, so 1% = 10"
          }
        },
        "decimals()": {
          "details": "Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."
        },
        "decreaseAllowance(address,uint256)": {
          "details": "Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the upd allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."
        },
        "feeWhitelist(address,bool)": {
          "details": "onlyOwner. Emits an {ExcludeFromFees} event",
          "params": {
            "_add": "The wallet to update",
            "_excluded": "If the wallet is excluded or not"
          }
        },
        "increaseAllowance(address,uint256)": {
          "details": "Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the upd allowance. Requirements: - `spender` cannot be the zero address."
        },
        "limitWhitelist(address,bool)": {
          "details": "onlyOwner. Emits an {ExcludeFromLimits} event",
          "params": {
            "_add": "The wallet to update",
            "_excluded": "If the wallet is excluded or not"
          }
        },
        "name()": {
          "details": "Returns the name of the token."
        },
        "newFeeBuySet(uint256)": {
          "details": "onlyOwner. Emits a {BuyFeeUpdated} event All fees added up must be less than 100",
          "params": {
            "_value": "The fee for the marketing wallet"
          }
        },
        "newFeeSellSet(uint256)": {
          "details": "onlyOwner. Emits a {SellFeeUpdated} event All fees added up must be less than 100",
          "params": {
            "_value": "The fee for the marketing wallet"
          }
        },
        "newLimitWalletMax(uint256)": {
          "details": "onlyOwner. Emits an {MaxWalletUpdated} event",
          "params": {
            "_maxWallet": "Base 1000, so 1% = 10"
          }
        },
        "openTrading()": {
          "details": "onlyOwner."
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "readAddressInfo(address)": {
          "params": {
            "_target": "The wallet to check"
          },
          "returns": {
            "_automatedMarketMakerPairs": "If the wallet is a automated market maker pair",
            "_transferLimitExempt": " If the wallet is excluded from max transaction amount",
            "_transferTaxExempt": " If the wallet is excluded from fees"
          }
        },
        "readContractSellInfo()": {
          "returns": {
            "_caSBcackValueMax": " the maximum amount of tokens in the contract balance to trigger swapback",
            "_caSBcackValueMin": " the minimum amount of tokens in the contract balance to trigger swapback",
            "_swapbackEnabled": " if swapback is enabled"
          }
        },
        "readFeesInfo()": {
          "returns": {
            "_buyTaxTotal": "The total fee for buys",
            "_sellTaxTotal": "The total fee for sells",
            "_transferTaxTotal": "The total fee for transfers"
          }
        },
        "readLimitsInfo()": {
          "returns": {
            "_limitsEnabled": " if the wallet limits are in effect",
            "_maxTx": " The maximum amount of tokens that can be bought or sold in a single transaction",
            "_maxWallet": " The maximum amount of tokens that can be held by a wallet"
          }
        },
        "readMarketingWalletInfo()": {
          "returns": {
            "_marketingWallet": "The wallet that receives the marketing fees"
          }
        },
        "removeLimitsNow()": {
          "details": "onlyOwner. Emits an {LimitsRemoved} event"
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "setNewMarketingWallet(address)": {
          "details": "onlyOwner. Emits an {MarketingWalletUpdated} event",
          "params": {
            "_marketing": "The new marketing wallet"
          }
        },
        "setSwapback(bool,uint256,uint256)": {
          "details": "onlyOwner. Emits an {SwapbackSettingsUpdated} event",
          "params": {
            "_caSBcEnabled": "If swapback is enabled",
            "_caSBcLimit": "The maximum amount of tokens the contract can swap for ETH. Base 10000, so 1% = 100.",
            "_caSBcTrigger": "The minimum amount of tokens the contract must have before swapping tokens for ETH. Base 10000, so 1% = 100."
          }
        },
        "symbol()": {
          "details": "Returns the symbol of the token, usually a shorter version of the name."
        },
        "totalSupply()": {
          "details": "See {IERC20-totalSupply}."
        },
        "transfer(address,uint256)": {
