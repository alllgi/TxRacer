        "allowance(address,address)": {
          "details": "Returns the amount of tokens that the spender is allowed to spend on behalf of the owner.",
          "params": {
            "from": "The address that approves the spending.",
            "to": "The address that is allowed to spend."
          },
          "returns": {
            "_0": "The remaining allowance for the spender."
          }
        },
        "approve(address,uint256)": {
          "details": "Approves the specified address to spend the specified amount of tokens on behalf of the caller.",
          "params": {
            "amount": "The amount of tokens to approve.",
            "to": "The address to approve the spending for."
          },
          "returns": {
            "_0": "A boolean value indicating whether the approval was successful."
          }
        },
        "balanceOf(address)": {
          "details": "Returns the balance of the specified account.",
          "params": {
            "account": "The address to check the balance for."
          },
          "returns": {
            "_0": "The balance of the account."
          }
        },
        "burn(uint256)": {
          "details": "Destroys `amount` tokens from the caller's account, reducing the total supply.",
          "params": {
            "amount": "The amount of tokens to burn."
          }
        },
        "constructor": {
          "details": "Contract constructor."
        },
        "decimals()": {
          "details": "Returns the number of decimals used for token display.",
          "returns": {
            "_0": "The number of decimals."
          }
        },
        "decreaseAllowance(address,uint256)": {
          "details": "Decreases the allowance granted by the owner of the tokens to `to` account.",
          "params": {
            "subtractedValue": "The amount of tokens to decrease the allowance by.",
            "to": "The account allowed to spend the tokens."
          },
          "returns": {
            "_0": "A boolean value indicating whether the operation succeeded."
          }
        },
        "increaseAllowance(address,uint256)": {
          "details": "Increases the allowance of the specified address to spend tokens on behalf of the caller.",
          "params": {
            "addedValue": "The amount of tokens to increase the allowance by.",
            "to": "The address to increase the allowance for."
          },
          "returns": {
            "_0": "A boolean value indicating whether the increase was successful."
          }
        },
        "name()": {
          "details": "Returns the name of the token.",
          "returns": {
            "_0": "The name of the token."
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
        },
        "symbol()": {
          "details": "Returns the symbol of the token.",
          "returns": {
            "_0": "The symbol of the token."
          }
        },
        "totalSupply()": {
          "details": "Returns the total supply of the token.",
          "returns": {
            "_0": "The total supply."
          }
        },
        "transfer(address,uint256)": {
          "details": "Transfers tokens from the caller to a specified recipient.",
          "params": {
            "amount": "The amount of tokens to transfer.",
            "recipient": "The address to transfer tokens to."
          },
          "returns": {
            "_0": "A boolean value indicating whether the transfer was successful."
          }
        },
        "transferFrom(address,address,uint256)": {
          "details": "Transfers tokens from one address to another.",
          "params": {
            "amount": "The amount of tokens to transfer.",
            "recipient": "The address to transfer tokens to.",
            "sender": "The address to transfer tokens from."
          },
          "returns": {
            "_0": "A boolean value indicating whether the transfer was successful."
          }
        },
