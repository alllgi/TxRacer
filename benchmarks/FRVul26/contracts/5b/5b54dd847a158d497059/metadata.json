          "params": {
            "baseVariableBorrowRate": "The base variable borrow rate, in bps",
            "optimalUsageRatio": "The optimal usage ratio, in bps",
            "reserve": "address of the reserve that has new interest rate data set",
            "variableRateSlope1": "The slope of the variable interest curve, before hitting the optimal ratio, in bps",
            "variableRateSlope2": "The slope of the variable interest curve, after hitting the optimal ratio, in bps"
          }
        }
      },
