    "devdoc": {
      "details": "`gem` balance is kept in `pocket` instead of this contract.A few assumptions are made:      1. There are no other urns for the same `ilk`      2. Stability fee is always zero for the `ilk`      3. The `spot` price for gem is always 1 (`10**27`).      4. The `spotter.par` (Dai parity) is always 1 (`10**27`).      5. This contract can freely transfer `gem` on behalf of `pocket`.",
      "events": {
        "BuyGem(address,uint256,uint256)": {
          "params": {
            "fee": "The fee in Dai paid by the user. [`wad`].",
            "owner": "The address receiving `gem`.",
            "value": "The amount of `gem` bought. [`gem` precision]."
          }
        },
        "Chug(uint256)": {
          "params": {
            "wad": "The amount of Dai added."
          }
        },
        "Deny(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "Diss(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "File(bytes32,address)": {
          "params": {
            "data": "The new value of the parameter.",
            "what": "The changed parameter name. [\"vow\"]."
          }
        },
        "File(bytes32,uint256)": {
          "params": {
            "data": "The new value of the parameter.",
            "what": "The changed parameter name. [\"tin\", \"tout\", \"buf\"]."
          }
        },
        "Fill(uint256)": {
          "params": {
            "wad": "The amount of Dai filled."
          }
        },
        "Kiss(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "Rely(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "SellGem(address,uint256,uint256)": {
          "params": {
            "fee": "The fee in Dai paid by the user. [`wad`].",
            "owner": "The address receiving Dai.",
            "value": "The amount of `gem` sold. [`gem` precision]."
          }
        },
        "Trim(uint256)": {
          "params": {
            "wad": "The amount of Dai trimmed."
          }
        }
      },
      "kind": "dev",
      "methods": {
        "buyGem(address,uint256)": {
          "details": "Reverts if `tout` is set to `HALTED`.",
          "params": {
            "gemAmt": "The amount of gem to buy. [`gem` precision].",
            "usr": "The destination of the bought gems."
          },
          "returns": {
            "daiInWad": "The amount of Dai required to sell."
          }
        },
        "buyGemNoFee(address,uint256)": {
          "details": "Only users whitelisted through `kiss()` can call this function.      Reverts if `tout` is set to `HALTED`.",
          "params": {
            "gemAmt": "The amount of gem to buy. [`gem` precision].",
            "usr": "The destination of the bought gems."
          },
          "returns": {
            "daiInWad": "The amount of Dai required to sell."
          }
        },
        "chug()": {
          "returns": {
            "wad": "The amount added to the surplus buffer."
          }
        },
        "constructor": {
          "params": {
            "daiJoin_": "The Dai adapter.",
            "gem_": "The gem to exchange with Dai.",
            "ilk_": "The collateral type identifier.",
            "pocket_": "The ultimate holder of `gem`."
          }
        },
        "cut()": {
          "details": "To keep `_sellGem` gas usage low, it allows users to take pre-minted Dai up to the whole balance, regardless      if part of it consist of collected fees.      If there is not enough balance, it will need to wait for new pre-minted Dai to be generated or Dai swapped      back to complete the withdrawal of fees.",
          "returns": {
            "wad": "The amount of Dai."
          }
        },
        "dec()": {
          "returns": {
            "_0": "The number of decimals for `gem`."
          }
        },
        "deny(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "diss(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "file(bytes32,address)": {
          "params": {
            "data": "The new value of the parameter.",
            "what": "The changed parameter name. [\"vow\"]."
          }
        },
        "file(bytes32,uint256)": {
          "details": "Swapping fees may not apply due to rounding errors for small swaps where      `gemAmt < 10**gem.decimals() / tin` or      `gemAmt < 10**gem.decimals() / tout`.Setting `tin` or `tout` to `HALTED` effectively disables selling and buying gems respectively.",
          "params": {
            "data": "The new value of the parameter.",
            "what": "The changed parameter name. [\"tin\", \"tout\", \"buf\"]."
          }
        },
        "fill()": {
          "details": "Both `buf`, the local and global debt ceilings limit the actual minted amount.      Notice that `gem` donations or extraneous debt repayments can also affect the amount.",
          "returns": {
            "wad": "The amount of Dai minted."
          }
        },
        "gemJoin()": {
          "details": "LitePsm does not have an external gem join. All logic is handled internally.      This function is required because there are some dependencies that assume every PSM has a gem join.",
          "returns": {
            "_0": "The address of this contract."
          }
        },
        "gush()": {
          "returns": {
            "wad": "The amount of Dai."
          }
        },
        "kiss(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "live()": {
          "returns": {
            "_0": "Whether the contract is live or not."
          }
        },
        "rely(address)": {
          "params": {
            "usr": "The user address."
          }
        },
        "rush()": {
          "returns": {
            "wad": "The amount of Dai."
          }
        },
        "sellGem(address,uint256)": {
          "details": "Reverts if `tin` is set to `HALTED`.",
          "params": {
            "gemAmt": "The amount of gem to sell. [`gem` precision].",
            "usr": "The destination of the bought Dai."
          },
          "returns": {
            "daiOutWad": "The amount of Dai bought."
          }
        },
        "sellGemNoFee(address,uint256)": {
          "details": "Only users whitelisted through `kiss()` can call this function.      Reverts if `tin` is set to `HALTED`.",
          "params": {
            "gemAmt": "The amount of gem to sell. [`gem` precision].",
            "usr": "The destination of the bought Dai."
          },
          "returns": {
            "daiOutWad": "The amount of Dai bought."
          }
        },
        "trim()": {
          "details": "The total outstanding debt can still be larger than the debt ceiling after `trim`.      Additional `buyGem` calls will enable further `trim` calls.",
          "returns": {
            "wad": "The amount of Dai burned."
          }
        }
      },
      "stateVariables": {
        "ARITHMETIC_ERROR": {
          "details": "Workaround to explicitly revert with an arithmetic error."
        },
        "HALTED": {
          "details": "Setting `tin` or `tout` to `type(uint256).max` will cause sell gem and buy gem functions respectively to revert."
        },
        "RAY": {
          "details": "`ray` precision for `vat` manipulation."
        },
        "WAD": {
          "details": "`wad` precision."
        },
        "buf": {
          "details": "`wad` precision."
        },
        "pocket": {
          "details": "This contract should be able to freely transfer `gem` on behalf of `pocket`."
        },
        "tin": {
          "details": "`wad` precision. 1 * WAD means a 100% fee."
        },
        "tout": {
          "details": "`wad` precision. 1 * WAD means a 100% fee."
        }
      },
      "title": "A lightweight PSM implementation.",
      "version": 1
    },
    "userdoc": {
      "events": {
        "BuyGem(address,uint256,uint256)": {
          "notice": "A user bought `gem` with Dai."
        },
        "Chug(uint256)": {
          "notice": "Dai accumulated as swap fees was added to the surplus buffer."
        },
        "Deny(address)": {
          "notice": "`usr` admin access was revoked."
        },
        "Diss(address)": {
          "notice": "Permission revoked for `usr` to swap without any fees."
        },
        "File(bytes32,address)": {
          "notice": "A contract parameter was updated."
        },
        "File(bytes32,uint256)": {
          "notice": "A contract parameter was updated."
        },
        "Fill(uint256)": {
          "notice": "The contract was filled with Dai."
        },
        "Kiss(address)": {
          "notice": "`usr` was granted permission to swap without any fees."
        },
        "Rely(address)": {
          "notice": "`usr` was granted admin access."
        },
        "SellGem(address,uint256,uint256)": {
          "notice": "A user sold `gem` for Dai."
        },
        "Trim(uint256)": {
          "notice": "The contract was trimmed of excess Dai."
        }
      },
      "kind": "user",
      "methods": {
        "HALTED()": {
          "notice": "Special value for `tin` and/or `tout` to indicate swaps are halted."
        },
        "bud(address)": {
          "notice": "Addresses with permission to swap with no fees. `bud[usr]`."
        },
        "buf()": {
