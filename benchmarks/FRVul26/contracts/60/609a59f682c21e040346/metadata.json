            "aum": "The AUM of the machine.",
            "shareTokenDecimalsOffset": "The decimals offset between share token and accounting token.",
            "supply": "The supply of the share token."
          },
          "returns": {
            "_0": "The calculated share price."
          }
        },
        "migrateFromPreDeposit(Machine.MachineStorage storage,address,address)": {
          "details": "Manages the migration from a pre-deposit vault to a machine, and initializes the machine's accounting state.",
          "params": {
            "$": "The machine storage struct.",
            "oracleRegistry": "The address of the oracle registry.",
            "preDepositVault": "The address of the pre-deposit vault."
          }
        },
        "updateSpokeCaliberAccountingData(Machine.MachineStorage storage,address,address,address,bytes,GuardianSignature[])": {
          "details": "Updates the spoke caliber accounting data in the machine storage.",
          "params": {
            "$": "The machine storage struct.",
            "chainRegistry": "The address of the chain registry.",
            "response": "The Wormhole CCQ response payload containing the accounting data.",
            "signatures": "The array of Wormhole guardians signatures attesting to the validity of the response.",
            "tokenRegistry": "The address of the token registry.",
            "wormhole": "The address of the Core Wormhole contract."
          }
