    "devdoc": {
      "author": "ConvexFinance",
      "details": "They say all paths lead to Rome, and the cvxBooster is no different. This is where it all goes down.          It is responsible for tracking all the pools, it collects rewards from all pools and redirects it.",
      "kind": "dev",
      "methods": {
        "constructor": {
          "details": "Constructor doing what constructors do. It is noteworthy that      a lot of basic config is set to 0 - expecting subsequent calls to setFeeInfo etc.",
          "params": {
            "_crv": "CRV",
            "_minter": "CVX token, or the thing that mints it",
            "_staker": "VoterProxy (locks the crv and adds to all gauges)",
            "_voteOwnership": "Address of the Curve DAO responsible for ownership stuff",
            "_voteParameter": "Address of the Curve DAO responsible for param updates"
          }
        },
        "distributeL2Fees(uint256)": {
          "details": "Distribute fees from L2 to L1 reward contracts",
          "params": {
            "_amount": "Amount of fees to distribute"
          }
        },
        "rewardClaimed(uint256,address,uint256)": {
          "details": "Goes off and mints a relative amount of `CVX` based on the distribution schedule."
        },
        "setBridgeDelegate(address)": {
          "details": "Set bridge delegate",
          "params": {
            "_bridgeDelegate": "The bridge delegate address"
          }
        },
        "setFeeInfo(address,address)": {
          "details": "This creates a secondary (VirtualRewardsPool) rewards contract for the vcxCrv staking contract"
        },
        "setFees(uint256,uint256,uint256,uint256)": {
          "params": {
            "_callerFees": "% for whoever calls the claim where 1% == 100",
            "_lockFees": "% for cvxCrv stakers where 1% == 100",
            "_platform": "% for \"treasury\" or vlCVX where 1% == 100",
            "_stakerFees": "% for CVX stakers where 1% == 100"
          }
        }
      },
      "title": "Booster",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "addPool(address,address,uint256)": {
          "notice": "Called by the PoolManager (i.e. PoolManagerProxy) to add a new pool - creates all the required         contracts (DepositToken, RewardPool, Stash) and then adds to the list!"
        },
        "claimRewards(uint256,address)": {
          "notice": "Allows a stash to claim secondary rewards from a gauge"
        },
        "deposit(uint256,uint256,bool)": {
          "notice": "Deposits an \"_amount\" to a given gauge (specified by _pid), mints a `DepositToken`          and subsequently stakes that on Convex BaseRewardPool"
        },
        "depositAll(uint256,bool)": {
          "notice": "Deposits all a senders balance to a given gauge (specified by _pid), mints a `DepositToken`          and subsequently stakes that on Convex BaseRewardPool"
        },
        "earmarkFees(address)": {
          "notice": "Claim fees from curve distro contract, put in lockers' reward contract.         lockFees is the secondary reward contract that uses the virtual balances from cvxCrv"
        },
        "earmarkRewards(uint256)": {
          "notice": "Basically a hugely pivotal function.         Responsible for collecting the crv from gauge, and then redistributing to the correct place.         Pays the caller a fee to process this."
        },
        "poolLength()": {
          "notice": "END SETTER SECTION ///"
        },
        "rewardClaimed(uint256,address,uint256)": {
          "notice": "Callback from reward contract when crv is received."
        },
        "setArbitrator(address)": {
          "notice": "Arbitrator handles tokens that are used as secondary rewards across multiple pools"
        },
        "setDelegate(address,address,bytes32)": {
          "notice": "Set delegate on snapshot"
        },
        "setFactories(address,address,address)": {
          "notice": "Factories are used when deploying new pools. Only the stash factory is mutable after init"
        },
        "setFeeInfo(address,address)": {
          "notice": "Set reward token and claim contract"
        },
        "setFeeManager(address)": {
          "notice": "Fee Manager can update the fees (lockIncentive, stakeIncentive, earmarkIncentive, platformFee)"
        },
        "setFees(uint256,uint256,uint256,uint256)": {
          "notice": "Fee manager can set all the relevant fees"
        },
        "setGaugeRedirect(uint256)": {
          "notice": "Tells the Curve gauge to redirect any accrued rewards to the given stash via the VoterProxy"
        },
        "setOwner(address)": {
          "notice": "Owner is responsible for setting initial config, updating vote delegate and shutting system"
        },
        "setPoolManager(address)": {
          "notice": "Pool manager is responsible for adding new pools"
        },
        "setRewardContracts(address,address)": {
          "notice": "Only called once, to set the addresses of cvxCrv (lockRewards) and cvx staking (stakerRewards)"
        },
        "setTreasury(address)": {
          "notice": "Set the address of the treasury (i.e. vlCVX)"
        },
        "setVote(bytes32)": {
          "notice": "set valid vote hash on VoterProxy "
        },
        "setVoteDelegate(address)": {
          "notice": "Vote Delegate has the rights to cast votes on the VoterProxy via the Booster"
        },
        "shutdownPool(uint256)": {
          "notice": "Shuts down the pool by withdrawing everything from the gauge to here (can later be         claimed from depositors by using the withdraw fn) and marking it as shut down"
        },
        "shutdownSystem()": {
          "notice": "Shuts down the WHOLE SYSTEM by withdrawing all the LP tokens to here and then allowing         for subsequent withdrawal by any depositors."
        },
        "updateFeeInfo(address,bool)": {
          "notice": "Allows turning off or on for fee distro"
        },
        "vote(uint256,address,bool)": {
          "notice": "Delegate address votes on dao via VoterProxy"
        },
        "voteGaugeWeight(address[],uint256[])": {
          "notice": "Delegate address votes on gauge weight via VoterProxy"
        },
        "withdraw(uint256,uint256)": {
          "notice": "Withdraw a given amount from a pool (must already been unstaked from the Convex Reward Pool -          BaseRewardPool uses withdrawAndUnwrap to get around this)"
        },
        "withdrawAll(uint256)": {
          "notice": "Withdraw all the senders LP tokens from a given gauge"
        },
        "withdrawTo(uint256,uint256,address)": {
          "notice": "Allows the actual BaseRewardPool to withdraw and send directly to the user"
        }
      },
      "notice": "Main deposit contract; keeps track of pool info & user deposits; distributes rewards.",
      "version": 1
    }
  },
