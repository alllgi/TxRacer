      "author": "Vittorio Minacori (https://github.com/vittominacori)",
      "details": "An utility library for using sorted linked list data structures in your Solidity project.",
      "kind": "dev",
      "methods": {
        "getAdjacent(StructuredLinkedList.List storage,uint256,bool)": {
          "details": "Returns the link of a node `_node` in direction `_direction`.",
          "params": {
            "_direction": "direction to step in",
            "_node": "id of the node to step from",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool, uint256 true if node exists or false otherwise, node in _direction"
          }
        },
        "getHead(StructuredLinkedList.List storage)": {
          "details": "Gets the head of the list",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256 the head of the list"
          }
        },
        "getNextNode(StructuredLinkedList.List storage,uint256)": {
          "details": "Returns the link of a node `_node` in direction `_NEXT`.",
          "params": {
            "_node": "id of the node to step from",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool, uint256 true if node exists or false otherwise, next node"
          }
        },
        "getNode(StructuredLinkedList.List storage,uint256)": {
          "details": "Returns the links of a node as a tuple",
          "params": {
            "_node": "id of the node to get",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool, uint256, uint256 true if node exists or false otherwise, previous node, next node"
          }
        },
        "getPreviousNode(StructuredLinkedList.List storage,uint256)": {
          "details": "Returns the link of a node `_node` in direction `_PREV`.",
          "params": {
            "_node": "id of the node to step from",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool, uint256 true if node exists or false otherwise, previous node"
          }
        },
        "getTail(StructuredLinkedList.List storage)": {
          "details": "Gets the head of the list",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256 the head of the list"
          }
        },
        "insertAfter(StructuredLinkedList.List storage,uint256,uint256)": {
          "details": "Insert node `_new` beside existing node `_node` in direction `_NEXT`.",
          "params": {
            "_new": "new node to insert",
            "_node": "existing node",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if success, false otherwise"
          }
        },
        "insertBefore(StructuredLinkedList.List storage,uint256,uint256)": {
          "details": "Insert node `_new` beside existing node `_node` in direction `_PREV`.",
          "params": {
            "_new": "new node to insert",
            "_node": "existing node",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if success, false otherwise"
          }
        },
        "listExists(StructuredLinkedList.List storage)": {
          "details": "Checks if the list exists",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if list exists, false otherwise"
          }
        },
        "nodeExists(StructuredLinkedList.List storage,uint256)": {
          "details": "Checks if the node exists",
          "params": {
            "_node": "a node to search for",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if node exists, false otherwise"
          }
        },
        "popBack(StructuredLinkedList.List storage)": {
          "details": "Pops the first entry from the tail of the linked list",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256 the removed node"
          }
        },
        "popFront(StructuredLinkedList.List storage)": {
          "details": "Pops the first entry from the head of the linked list",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256 the removed node"
          }
        },
        "pushBack(StructuredLinkedList.List storage,uint256)": {
          "details": "Pushes an entry to the tail of the linked list",
          "params": {
            "_node": "new entry to push to the tail",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if success, false otherwise"
          }
        },
        "pushFront(StructuredLinkedList.List storage,uint256)": {
          "details": "Pushes an entry to the head of the linked list",
          "params": {
            "_node": "new entry to push to the head",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "bool true if success, false otherwise"
          }
        },
        "remove(StructuredLinkedList.List storage,uint256)": {
          "details": "Removes an entry from the linked list",
          "params": {
            "_node": "node to remove from the list",
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256 the removed node"
          }
        },
        "sizeOf(StructuredLinkedList.List storage)": {
          "details": "Returns the number of elements in the list",
          "params": {
            "self": "stored linked list from contract"
          },
          "returns": {
            "_0": "uint256"
          }
        }
      },
