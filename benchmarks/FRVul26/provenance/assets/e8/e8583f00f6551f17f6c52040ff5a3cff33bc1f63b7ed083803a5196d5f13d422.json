    "devdoc": {
      "author": "Angle Labs, Inc.",
      "details": "There may be duplicates in the info provided by the getters defined here",
      "kind": "dev",
      "methods": {
        "getCollateralRatio()": {
          "details": "This function may revert and overflow if the collateral ratio is too big due to a too small amount of `stablecoinsIssued`. Due to this, it is recommended to initialize the system with a non negligible amount of `stablecoinsIssued` so DoS attacks on redemptions which use this function become economically impossible"
        },
        "getOracle(address)": {
          "returns": {
            "oracleData": "Extra data needed to read the oracle. For Chainlink oracles, this data is supposed to give the addresses of the Chainlink feeds to read, the stale periods for each feed, ...",
            "oracleType": "Type of oracle (Chainlink, external smart contract, ...)",
            "targetData": "Extra data needed to read the target price of the asset",
            "targetType": "Type passed to read the value of the target price"
          }
        },
        "getOracleValues(address)": {
          "details": "This function is not optimized for gas consumption as for instance the `burn` value for collateral is computed twice: once in `readBurn` and once in `getBurnOracle`",
          "returns": {
            "burn": "Oracle value that will be used for `collateral` for a burn transaction. This value is then used along with oracle values for all other collateral assets to get a global burn value for the oracle",
            "minRatio": "Minimum ratio across all collateral assets between a collateral burn price and its target price. This value is independent of `collateral` and is used to normalize the burn oracle value for burn transactions.",
            "mint": "Oracle value to be used for a mint transaction with `collateral`",
            "ratio": "Ratio, in base `10**18` between the oracle value of the `collateral` and its target price. This value is 10**18 if the oracle is greater than the collateral price",
            "redemption": "Oracle value that would be used to price `collateral` when computing the collateral ratio during a redemption"
          }
        },
        "isWhitelistedForCollateral(address,address)": {
          "details": "This function is non view as it may consult external non view functions from whitelist providers"
        },
        "isWhitelistedForType(uint8,address)": {
          "details": "Note that ultimately whitelisting may depend as well on external providers"
        }
      },
      "title": "Getters",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "accessControlManager()": {
          "notice": "Reference to the `accessControlManager` contract of the system"
        },
        "agToken()": {
          "notice": "Stablecoin minted by transmuter"
        },
        "getCollateralBurnFees(address)": {
          "notice": "Returns the `xFee` and `yFee` arrays from which fees are computed when coming to burn for `collateral`"
        },
        "getCollateralDecimals(address)": {
          "notice": "Returns the decimals of a given `collateral`"
        },
        "getCollateralInfo(address)": {
          "notice": "Returns all the info in storage associated to a `collateral`"
        },
        "getCollateralList()": {
          "notice": "Returns the list of collateral assets supported by the system"
        },
        "getCollateralMintFees(address)": {
          "notice": "Returns the `xFee` and `yFee` arrays from which fees are computed when coming to mint with `collateral`"
        },
        "getCollateralRatio()": {
          "notice": "Returns the collateral ratio of Transmuter in base `10**9` and a rounded version of the total amount of stablecoins issued"
        },
        "getCollateralWhitelistData(address)": {
          "notice": "Gets the data needed to deal with whitelists for `collateral`"
        },
        "getIssuedByCollateral(address)": {
          "notice": "Returns the amount of stablecoins issued from `collateral` and the total amount of stablecoins issued through Transmuter"
        },
        "getManagerData(address)": {
          "notice": "Returns if a collateral is \"managed\" and the associated manager configuration"
        },
        "getOracle(address)": {
          "notice": "Returns the data used to compute oracle values for `collateral`"
        },
        "getOracleValues(address)": {
          "notice": "Returns the oracle values associated to `collateral`"
        },
        "getRedemptionFees()": {
          "notice": "Returns the `xFee` and `yFee` arrays used to compute the penalty factor depending on the collateral ratio when users come to redeem"
        },
        "getTotalIssued()": {
          "notice": "Returns the total amount of stablecoins issued through Transmuter"
        },
        "isPaused(address,uint8)": {
          "notice": "Returns if the associated functionality is paused or not"
        },
        "isTrusted(address)": {
          "notice": "Returns if `sender` is trusted to update normalizers"
        },
        "isTrustedSeller(address)": {
          "notice": "Returns if `sender` is trusted to update sell rewards"
        },
        "isValidSelector(bytes4)": {
          "notice": "Checks whether a given `selector` is actually a valid selector corresponding to a function in one of the facets of the proxy"
        },
        "isWhitelistedCollateral(address)": {
          "notice": "Checks whether only whitelisted address can deal with `collateral` during burns and redemptions"
        },
        "isWhitelistedForCollateral(address,address)": {
          "notice": "Checks whether `sender` can deal with `collateral` during burns and redemptions"
        },
        "isWhitelistedForType(uint8,address)": {
          "notice": "Checks whether `sender` has a non null entry in the `isWhitelistedForType` storage mapping"
        }
      },
      "version": 1
    }
