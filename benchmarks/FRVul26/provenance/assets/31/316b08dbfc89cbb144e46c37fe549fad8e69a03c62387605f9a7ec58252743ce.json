      "author": "LI.FI (https://li.fi)",
      "custom:version": "2.0.4",
      "events": {
        "AssetSwapped(bytes32,address,address,address,uint256,uint256,uint256)": {
          "params": {
            "dex": "The address of the DEX or contract that handled the swap",
            "fromAmount": "The amount of `fromAssetId` sent",
            "fromAssetId": "The address of the token that was sent",
            "timestamp": "The timestamp when the swap was executed",
            "toAmount": "The amount of `toAssetId` received",
            "toAssetId": "The address of the token that was received",
            "transactionId": "The unique identifier associated with the swap operation"
          }
        }
      },
      "kind": "dev",
      "methods": {
        "getDestinationChainsValue(uint8[])": {
          "details": "Returns a value that signals to Gas.zip to which chains gas should be sent in equal parts",
          "params": {
            "_chainIds": "a list of Gas.zip-specific chainIds (not the original chainIds), see https://dev.gas.zip/gas/chain-support/outbound"
          }
        },
        "startBridgeTokensViaGasZip((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(bytes32,uint256))": {
          "details": "this function only supports native flow. For ERC20 flows this facet should be used as a protocol step instead",
          "params": {
            "_bridgeData": "The core information needed for bridging",
            "_gasZipData": "contains information which chains and address gas should be sent to"
          }
        },
        "swapAndStartBridgeTokensViaGasZip((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(address,address,address,address,uint256,bytes,bool)[],(bytes32,uint256))": {
          "params": {
            "_bridgeData": "The core information needed for depositing",
            "_gasZipData": "contains information which chains and address gas should be sent to",
            "_swapData": "An array of swap related data for performing swaps before bridging"
          }
        }
      },
