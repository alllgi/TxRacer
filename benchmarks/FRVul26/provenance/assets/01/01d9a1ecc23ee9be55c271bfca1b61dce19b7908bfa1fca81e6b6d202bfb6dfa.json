        "addToWhitelist(address)": {
          "details": "called by the owner to enable some address for whitelist"
        },
        "claimAllowanceOwnership()": {
          "details": "claim ownership of allowance sheet passed into constructor.*"
        },
        "claimBalanceOwnership()": {
          "details": "claim ownership of balance sheet passed into constructor.*"
        },
        "claimOwnership()": {
          "details": "Allows the pendingOwner address to finalize the transfer."
        },
        "decreaseApproval(address,uint256)": {
          "details": "Decrease the amount of tokens that an owner allowed to a spender.",
          "params": {
            "_spender": "The address which will spend the funds.",
            "_subtractedValue": "The amount of tokens to decrease the allowance by."
          }
        },
        "disableBlacklist()": {
          "details": "called by the owner to disable blacklist"
        },
        "disableWhitelist()": {
          "details": "called by the owner to disable whitelist"
        },
        "enableBlacklist()": {
          "details": "called by the owner to enable blacklist"
        },
        "enableWhitelist()": {
          "details": "called by the owner to enable whitelist"
        },
        "increaseApproval(address,uint256)": {
          "details": "Increase the amount of tokens that an owner allowed to a spender.",
          "params": {
            "_addedValue": "The amount of tokens to increase the allowance by.",
            "_spender": "The address which will spend the funds."
          }
        },
        "lock()": {
          "details": "called by the owner to disable method, back to normal state"
        },
        "pause()": {
          "details": "called by the owner to pause, triggers stopped state"
        },
        "removeFromWhitelist(address)": {
          "details": "called by the owner to disable address for whitelist"
        },
        "removeFromblacklist(address)": {
          "details": "called by the owner to disable address for blacklist"
        },
        "removePermBalanceToWhitelist(address)": {
          "details": "called by the owner to remove permitted balance for transfer"
        },
        "transferFrom(address,address,uint256)": {
          "details": "When implemented, it should use the transferFromConditionsRequired() modifier.",
          "params": {
            "_amount": "The number of tokens to transfer",
            "_from": "The address of the origin of funds. This address _could_ be blacklisted, because a regulator may want to transfer tokens out of a blacklisted account, for example. In order to do so, the regulator would have to add themselves as an approved spender on the account via `addBlacklistAddressSpender()`, and would then be able to transfer tokens out of it.",
            "_to": "The address of the recipient. This address must not be blacklisted."
          },
          "return": "`true` if successful "
        },
        "transferOwnership(address)": {
          "details": "Allows the current owner to transfer control of the contract to a newOwner.",
          "params": {
            "_newOwner": "The address to transfer ownership to."
          }
        },
        "unlock()": {
          "details": "called by the owner to enable method"
        },
        "unpause()": {
          "details": "called by the owner to unpause, returns to normal state"
        }
