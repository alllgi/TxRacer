            "sendingAssetId": "The sending asset id extracted from the calldata"
          }
        },
        "extractMainParameters(bytes)": {
          "params": {
            "data": "The calldata to extract the main parameters from"
          },
          "returns": {
            "amount": "The min amountfrom the calldata",
            "bridge": "The bridge extracted from the calldata",
            "destinationChainId": "The destination chain id extracted from the calldata",
            "hasDestinationCall": "Whether the calldata has a destination call",
            "hasSourceSwaps": "Whether the calldata has source swaps",
            "receiver": "The receiver extracted from the calldata",
            "sendingAssetId": "The sending asset id extracted from the calldata"
          }
        },
        "extractSwapData(bytes)": {
          "params": {
            "data": "The calldata to extract the swap data from"
          },
          "returns": {
            "swapData": "The swap data extracted from the calldata"
          }
        },
        "validateCalldata(bytes,string,address,address,uint256,uint256,bool,bool)": {
          "params": {
            "amount": "The amount to validate or type(uint256).max to ignore",
            "bridge": "The bridge to validate or empty string to ignore",
            "data": "The calldata to validate",
            "destinationChainId": "The destination chain id to validate        or type(uint256).max to ignore",
            "hasDestinationCall": "Whether the calldata has a destination call",
            "hasSourceSwaps": "Whether the calldata has source swaps",
            "receiver": "The receiver to validate        or 0xFFfFfFffFFfffFFfFFfFFFFFffFFFffffFfFFFfF to ignore",
            "sendingAssetId": "The sending asset id to validate        or 0xFFfFfFffFFfffFFfFFfFFFFFffFFFffffFfFFFfF to ignore"
          },
          "returns": {
            "isValid": "Whether the calldata is validate"
          }
        },
        "validateDestinationCalldata(bytes,bytes,bytes)": {
          "params": {
            "callTo": "The call to address to validate",
            "data": "The calldata to validate",
            "dstCalldata": "The destination calldata to validate"
          },
          "returns": {
            "isValid": "Whether the destination calldata is validate"
          }
        }
