    "devdoc": {
      "author": "LI.FI (https://li.fi)",
      "custom:version": "1.0.0",
      "details": "This contract does not custody user funds. Any native tokens received are either forwarded      to the underlying Across contracts or refunded to the sender via the refundExcessNative modifier.      IMPORTANT: This facet is calldata-driven and consumes opaque ABI-encoded calldata (generated off-chain).      For the `SpokePool` and `SpokePoolPeriphery` paths, the final receiver is encoded inside dynamic      calldata that cannot be fully validated on-chain against `BridgeData.receiver`.      This is a different trust model than most LI.FI facets, where we can strictly validate that the      protocol-specific receiver matches `BridgeData.receiver`.      To protect integrators, clients, and partners, these two opaque paths require a backend signature      over `BridgeData` and the calldata hash. This gates usage to calldata generated by LI.FI backend      infrastructure and prevents arbitrary calldata injection via public entrypoints.",
      "errors": {
        "TransferFailed()": [
          {
            "details": "The ERC20 `transfer` has failed."
          }
        ]
      },
