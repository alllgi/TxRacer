    "devdoc": {
      "author": "Angle Labs, Inc.",
      "kind": "dev",
      "methods": {
        "addCollateral(address)": {
          "details": "Collateral assets with a fee on transfer are not supported by the system"
        },
        "adjustStablecoins(address,uint128,bool)": {
          "details": "The amount passed here must be an absolute amount"
        },
        "changeAllowance(address,address,uint256)": {
          "details": "This function can typically be used to grant allowance to a newly added manager for it to pull the funds associated to the collateral it corresponds to"
        },
        "recoverERC20(address,address,address,uint256)": {
          "details": "No check is made on the collateral that is redeemed: this function could typically be used by a governance during a manual rebalance of the reserves of the system`collateral` is different from `token` only in the case of a managed collateral"
        },
        "revokeCollateral(address)": {
          "details": "Require `collatInfo.normalizedStables == 0`, that is to say that the collateral is not used to back stablesThe system may still have a non null balance of the collateral that is revoked: this should later be handled through a recoverERC20 callFunds needs to have been withdrew from the manager prior to this call"
        },
        "setCollateralManager(address,(address[],bytes))": {
          "details": "Funds need to have been withdrawn from the eventual previous manager prior to this call"
        }
      },
      "title": "SettersGovernor",
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "addCollateral(address)": {
          "notice": "Add `collateral` as a supported collateral in the system"
        },
        "adjustStablecoins(address,uint128,bool)": {
          "notice": "Adjusts the amount of stablecoins issued from `collateral` by `amount`"
        },
        "changeAllowance(address,address,uint256)": {
          "notice": "Sets the allowance of the contract on `token` for `spender` to `amount`"
        },
        "recoverERC20(address,address,address,uint256)": {
          "notice": "Recovers `amount` of `token` from the Transmuter contract"
        },
        "revokeCollateral(address)": {
          "notice": "Revokes `collateral` from the system"
        },
        "setAccessControlManager(address)": {
          "notice": "Sets a new access control manager address"
        },
        "setCollateralManager(address,(address[],bytes))": {
          "notice": "Sets (or unsets) a collateral manager  `collateral`"
        },
        "setOracle(address,bytes)": {
          "notice": "Sets the `oracleConfig` used to read the value of `collateral` for the mint, burn and redemption operations"
        },
        "setWhitelistStatus(address,uint8,bytes)": {
          "notice": "Changes whether a `collateral` can only be handled during burns and redemptions by whitelisted addresses and sets the data used to read into the whitelist"
        },
        "toggleTrusted(address,uint8)": {
          "notice": "Changes the trusted status for `sender` when for selling rewards or updating the normalizer"
        },
        "updateOracle(address)": {
          "notice": "Update oracle data for a given `collateral`"
        }
      },
      "version": 1
    }
