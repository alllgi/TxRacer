    "devdoc": {
      "details": "Fee Distribution:      1. Partner receives: 100% of fixed fee (calculated on quotedAmount + surplus)      2. Protocol receives: 50% of remaining surplus (after fixed fee is taken)      3. User receives: Everything else",
      "kind": "dev",
      "methods": {
        "constructor": {
          "params": {
            "_feeVault": "Address of the AugustusFeeVault contract",
            "_permit2": "Address of the Permit2 contract"
          }
        },
        "parsePartnerAndFeeData(uint256)": {
          "details": "`partnerAndFee` is a uint256 value where data is packed in a specific bit layout.      The bit layout for `partnerAndFee` is as follows:      - The most significant 160 bits (positions 255 to 96) represent the partner address.      - Bits 95 to 92 are reserved for flags indicating various fee processing conditions:          - 95th bit: `IS_TAKE_SURPLUS_MASK` - Partner takes surplus          - 94th bit: `IS_REFERRAL_MASK` - Referral takes surplus          - 93rd bit: `IS_SKIP_BLACKLIST_MASK` - Bypass token blacklist when processing fees          - 92nd bit: `IS_CAP_SURPLUS_MASK` - Cap surplus to 1% of quoted amount      - The least significant 16 bits (positions 15 to 0) encode the fee percentage.",
          "params": {
            "partnerAndFee": "Packed uint256 containing both partner address and fee data."
          },
          "returns": {
            "feeData": "The extracted fee data containing the fee percentage and flags.",
            "partner": "The extracted partner address as a payable address."
          }
        },
        "swapExactAmountInPro(address,(address,address,uint256,uint256,uint256,bytes32,address),uint256,bytes,bytes)": {
          "details": "Fee split: Partner gets 100% of fixed fees, ParaSwap gets 50% of remaining surplus",
          "params": {
            "executor": "The address of the executor contract to use",
            "executorData": "The data to execute on the executor",
            "partnerAndFee": "Packed uint256 with partner address and fee configuration",
            "permit": "The permit data for token approval",
            "swapData": "Generic data containing the swap information"
          },
          "returns": {
            "paraswapShare": "Protocol's fee share (50% of remaining surplus after fixed fee)",
            "partnerShare": "Partner's fee share (100% of the fixed fee)",
            "receivedAmount": "The amount of destToken the user receives (after all fees)"
          }
        },
        "swapExactAmountOutPro(address,(address,address,uint256,uint256,uint256,bytes32,address),uint256,bytes,bytes)": {
          "details": "Fee split: Partner gets 100% of fixed fees, ParaSwap gets 50% of surplus (spending less)",
          "params": {
            "executor": "The address of the executor contract to use",
            "executorData": "The data to execute on the executor",
            "partnerAndFee": "Packed uint256 with partner address and fee configuration",
            "permit": "The permit data for token approval",
            "swapData": "Generic data containing the swap information"
          },
          "returns": {
            "paraswapShare": "Protocol's fee share (50% of surplus from spending less)",
            "partnerShare": "Partner's fee share (100% of the fixed fee)",
            "receivedAmount": "The amount of destToken the user receives",
            "spentAmount": "The actual amount of srcToken spent in the swap"
          }
        }
      },
      "title": "ProPartnerFacet",
      "version": 1
    },
