    "devdoc": {
      "author": "LI.FI (https://li.fi)",
      "custom:version": "2.2.0",
      "details": "The LI.FI chain ID to AllBridge chain ID mapping is held in diamond      storage and is owner-updatable (initAllBridge / setChainIdToAllBridgeChainId /      unsetChainIdToAllBridgeChainId), so new destinations can be added without a      facet redeploy. The facet must be initialized via initAllBridge before it can      bridge; an uninitialized (or unmapped) destination reverts UnsupportedAllBridgeChainId.This contract is not intended to custody user funds; any balances held are      incidental and transient during a bridge call and should not persist.",
      "events": {
        "AssetSwapped(bytes32,address,address,address,uint256,uint256,uint256)": {
          "params": {
            "dex": "The address of the DEX or contract that handled the swap",
            "fromAmount": "The amount of `fromAssetId` sent",
            "fromAssetId": "The address of the token that was sent",
            "timestamp": "The timestamp when the swap was executed",
            "toAmount": "The amount of `toAssetId` received",
            "toAssetId": "The address of the token that was received",
            "transactionId": "The unique identifier associated with the swap operation"
          }
        }
      },
      "kind": "dev",
      "methods": {
        "constructor": {
          "params": {
            "_allBridge": "The address of the AllBridge contract"
          }
        },
        "getChainIdToAllBridgeChainId(uint256)": {
          "params": {
            "_chainId": "LI.FI chain ID"
          },
          "returns": {
            "_0": "The corresponding AllBridge chain ID"
          }
        },
        "initAllBridge((uint256,uint256)[])": {
          "details": "Re-initialization overwrites the provided mappings and leaves the rest untouched.A zero chainId or allBridgeChainId is rejected: 0 is the reserved      \"unmapped\" sentinel (see Storage), so it must never be stored. https://docs-core.allbridge.io/product/how-does-allbridge-core-work/allbridge-core-contracts",
          "params": {
            "chainIdConfigs": "Chain ID configuration data"
          }
        },
        "setChainIdToAllBridgeChainId((uint256,uint256)[])": {
          "details": "A zero chainId or allBridgeChainId is rejected; use      unsetChainIdToAllBridgeChainId to remove a mapping.",
          "params": {
            "chainIdConfigs": "Chain ID configuration data"
          }
        },
        "startBridgeTokensViaAllBridge((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(bytes32,uint256,bytes32,uint256,uint8,bool))": {
          "params": {
            "_bridgeData": "The bridge data struct"
          }
        },
        "swapAndStartBridgeTokensViaAllBridge((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(address,address,address,address,uint256,bytes,bool)[],(bytes32,uint256,bytes32,uint256,uint8,bool))": {
          "params": {
            "_allBridgeData": "The AllBridge data struct",
            "_bridgeData": "The bridge data struct",
            "_swapData": "The swap data struct"
          }
        },
        "unsetChainIdToAllBridgeChainId(uint256)": {
          "params": {
            "_chainId": "LI.FI chain ID"
          }
        }
      },
      "title": "AllBridgeFacet",
      "version": 1
    },
    "userdoc": {
      "errors": {
        "ReentrancyError()": [
          {
            "notice": "Errors ///"
          }
        ]
      },
      "events": {
        "AllBridgeChainMappingsInitialized((uint256,uint256)[])": {
          "notice": "Events ///"
