        "AssetSwapped(bytes32,address,address,address,uint256,uint256,uint256)": {
          "notice": "Emitted after a successful asset swap or related operation"
        },
        "LiFiTransferStarted((bytes32,string,string,address,address,address,uint256,uint256,bool,bool))": {
          "notice": "Events ///"
        }
      },
      "kind": "user",
      "methods": {
        "constructor": {
          "notice": "Initializes the AllBridge contract"
        },
        "getChainIdToAllBridgeChainId(uint256)": {
          "notice": "Gets the AllBridge chain ID for a given LI.FI chain ID"
        },
        "initAllBridge((uint256,uint256)[])": {
          "notice": "Initializes the LI.FI chain ID to AllBridge chain ID mappings"
        },
        "setChainIdToAllBridgeChainId((uint256,uint256)[])": {
          "notice": "Sets the AllBridge chain ID for one or more LI.FI chain IDs"
        },
        "startBridgeTokensViaAllBridge((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(bytes32,uint256,bytes32,uint256,uint8,bool))": {
          "notice": "Bridge tokens to another chain via AllBridge"
        },
        "swapAndStartBridgeTokensViaAllBridge((bytes32,string,string,address,address,address,uint256,uint256,bool,bool),(address,address,address,address,uint256,bytes,bool)[],(bytes32,uint256,bytes32,uint256,uint8,bool))": {
          "notice": "Bridge tokens to another chain via AllBridge"
        },
        "unsetChainIdToAllBridgeChainId(uint256)": {
          "notice": "Removes the AllBridge chain ID mapping for a given LI.FI chain ID"
        }
      },
      "notice": "Provides functionality for bridging through AllBridge",
      "version": 1
    }
