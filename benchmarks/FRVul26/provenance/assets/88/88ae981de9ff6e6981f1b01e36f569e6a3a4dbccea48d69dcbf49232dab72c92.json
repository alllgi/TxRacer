    "devdoc": {
      "author": "LI.FI (https://li.fi)",
      "custom:version": "1.0.1",
      "details": "Admin-Facet for emergency purposes only",
      "kind": "dev",
      "methods": {
        "constructor": {
          "params": {
            "_pauserWallet": "The address of the wallet that can execute emergency facet removal actions"
          }
        },
        "pauseDiamond()": {
          "details": "can only be executed by pauserWallet (non-multisig for fast response time) or by the diamond ownerThis function could potentially run out of gas if too many facets/function selectors are involved.      We mitigate this issue by having a test on forked mainnet (which has most facets)      that checks if the diamond can be pausedforked mainnet (which has most facets) that checks if the diamond can be paused"
        },
        "removeFacet(address)": {
          "details": "can only be executed by pauserWallet (non-multisig for fast response time) or by the diamond owner",
          "params": {
            "_facetAddress": "The address of the facet that should be removed"
          }
        },
        "unpauseDiamond(address[])": {
          "details": "can only be executed by diamond owner (multisig)",
          "params": {
            "_blacklist": "The address(es) of facet(s) that should not be reactivated"
          }
        }
      },
      "title": "EmergencyPauseFacet (Admin only)",
      "version": 1
    },
    "userdoc": {
      "errors": {
        "FacetIsNotRegistered()": [
          {
            "notice": "Errors ///"
          }
        ]
      },
      "events": {
        "EmergencyFacetRemoved(address,address)": {
          "notice": "Events ///"
        }
      },
      "kind": "user",
      "methods": {
        "constructor": {
          "notice": "Constructor ///"
        },
        "pauseDiamond()": {
          "notice": "Effectively pauses the diamond contract by overwriting the facetAddress-to-function-selector         mappings in storage for all facets and redirecting all function selectors to the         EmergencyPauseFacet (this will remain as the only registered facet) so that         a meaningful error message will be returned when third parties try to call the diamond"
        },
        "pauserWallet()": {
          "notice": "Storage ///"
        },
        "removeFacet(address)": {
          "notice": "Removes the given facet from the diamond"
        },
        "unpauseDiamond(address[])": {
          "notice": "Unpauses the diamond contract by re-adding all facetAddress-to-function-selector mappings to storage"
        }
      },
      "notice": "Allows a LI.FI-owned and -controlled, non-multisig \"PauserWallet\" to remove a facet         or pause the diamond in case of emergency",
      "version": 1
    }
