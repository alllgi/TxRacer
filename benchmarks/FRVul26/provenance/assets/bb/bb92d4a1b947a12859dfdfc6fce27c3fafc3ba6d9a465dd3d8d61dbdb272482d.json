    "devdoc": {
      "author": "LI.FI (https://li.fi)",
      "custom:version": "1.0.0",
      "kind": "dev",
      "methods": {
        "batchSetContractSelectorWhitelist(address[],bytes4[],bool)": {
          "details": "APPROVE TO-ONLY SELECTOR: Use 0xffffffff to whitelist contracts that are used      only as approveTo in LibSwap.SwapData, without allowing function calls to them.      Some DEXs have specific contracts that need to be approved to while another      (router) contract must be called to initiate the swap. This selector enables      whitelisting such approveTo-only contracts while preventing any function calls.      Note: This makes isAddressWhitelisted(_contract) return true for backward      compatibility, but does not allow any granular calls. Actual selectors must      still be explicitly whitelisted for real function call usage.",
          "params": {
            "_contracts": "Array of contract addresses to whitelist or unwhitelist.",
            "_selectors": "Array of function selectors to whitelist or unwhitelist.",
            "_whitelisted": "Whether the contract and selector pairs should be whitelisted."
          }
        },
        "getAllContractSelectorPairs()": {
          "details": "This is more efficient than calling getWhitelistedAddresses() and then      getWhitelistedSelectorsForContract() for each address separately.",
          "returns": {
            "contracts": "Array of whitelisted contract addresses.",
            "selectors": "Array of corresponding selector arrays for each contract."
          }
        },
        "getWhitelistedAddresses()": {
          "details": "WARNING: This function reads from the global list and is NOT granular.      It is required for older, deployed facets to function correctly.      Avoid use in new code. Use isContractSelectorWhitelisted() instead.      Reading ~10 000 entries is safe, but if the list grows toward ~45 000+,      the call may run out of gas. Do not rely on it for unbounded iteration.",
          "returns": {
            "addresses": "List of whitelisted addresses."
          }
        },
        "getWhitelistedFunctionSelectors()": {
          "details": "WARNING: This function reads from the global list and is NOT granular.      It is required for older, deployed facets to function correctly.      Avoid use in new code. Use isContractSelectorWhitelisted() instead.      Reading ~10 000 entries is safe, but if the list grows toward ~45 000+,      the call may run out of gas. Do not rely on it for unbounded iteration.",
          "returns": {
            "selectors": "List of approved function selectors."
          }
        },
        "getWhitelistedSelectorsForContract(address)": {
          "params": {
            "_contract": "The contract address to query."
          },
          "returns": {
            "selectors": "List of whitelisted selectors for the contract."
          }
        },
        "isAddressWhitelisted(address)": {
          "details": "WARNING: This function reads from the global list and is NOT granular.      It is required for older, deployed facets to function correctly.      Avoid use in new code. Use isContractSelectorWhitelisted() instead.",
          "params": {
            "_address": "The address to query."
          },
          "returns": {
            "whitelisted": "Whitelisted or not."
          }
        },
        "isContractSelectorWhitelisted(address,bytes4)": {
          "params": {
            "_contract": "The contract address to query.",
            "_selector": "The function selector to query."
          },
          "returns": {
            "whitelisted": "Whether the pair is whitelisted."
          }
        },
        "isFunctionSelectorWhitelisted(bytes4)": {
          "details": "WARNING: This function reads from the global list and is NOT granular.      It is required for older, deployed facets to function correctly.      Avoid use in new code. Use isContractSelectorWhitelisted() instead.",
          "params": {
            "_selector": "The function selector to query."
          },
          "returns": {
            "whitelisted": "Whitelisted or not."
          }
        },
        "isMigrated()": {
          "details": "Remove these methods after migration is complete in next facet upgrade.",
          "returns": {
            "_0": "True if the allow list has been migrated, false otherwise."
          }
        },
        "migrate(bytes4[],address[],bytes4[][])": {
          "details": "Remove these methods after migration is complete in next facet upgrade.",
          "params": {
            "_contracts": "Array of contract addresses.",
            "_selectors": "Parallel array of selector arrays for each contract.",
            "_selectorsToRemove": "Array of selectors to remove from the allow list."
          }
        },
        "setContractSelectorWhitelist(address,bytes4,bool)": {
          "details": "APPROVE TO-ONLY SELECTOR: Use 0xffffffff to whitelist contracts that are used      only as approveTo in LibSwap.SwapData, without allowing function calls to them.      Some DEXs have specific contracts that need to be approved to while another      (router) contract must be called to initiate the swap. This selector enables      whitelisting such approveTo-only contracts while preventing any function calls.      Note: This makes isAddressWhitelisted(_contract) return true for backward      compatibility, but does not allow any granular calls. Actual selectors must      still be explicitly whitelisted for real function call usage.",
          "params": {
            "_contract": "The contract address to whitelist or unwhitelist.",
            "_selector": "The function selector to whitelist or unwhitelist.",
            "_whitelisted": "Whether the contract and selector pair should be whitelisted."
          }
        }
      },
      "title": "WhitelistManagerFacet",
      "version": 1
    },
    "userdoc": {
      "events": {
        "ContractSelectorWhitelistChanged(address,bytes4,bool)": {
          "notice": "Emitted when a contract and selector pair is whitelisted or unwhitelisted."
        }
      },
      "kind": "user",
      "methods": {
        "batchSetContractSelectorWhitelist(address[],bytes4[],bool)": {
          "notice": "Sets the whitelist status for multiple contract and selector pairs."
        },
        "getAllContractSelectorPairs()": {
          "notice": "Returns all whitelisted contract-selector pairs in a single call."
        },
        "getWhitelistedAddresses()": {
          "notice": "[BACKWARD COMPATIBILITY] Returns a list of all whitelisted addresses."
        },
        "getWhitelistedFunctionSelectors()": {
          "notice": "[BACKWARD COMPATIBILITY] Returns a list of all approved function selectors."
        },
        "getWhitelistedSelectorsForContract(address)": {
          "notice": "Returns a list of whitelisted selectors for a specific contract."
        },
        "isAddressWhitelisted(address)": {
          "notice": "[BACKWARD COMPATIBILITY] Returns whether an address is whitelisted."
        },
        "isContractSelectorWhitelisted(address,bytes4)": {
          "notice": "Returns whether a specific contract and selector pair is whitelisted."
        },
        "isFunctionSelectorWhitelisted(bytes4)": {
          "notice": "[BACKWARD COMPATIBILITY] Returns whether a function selector is whitelisted."
        },
        "isMigrated()": {
          "notice": "Check if the allow list has been migrated."
        },
        "migrate(bytes4[],address[],bytes4[][])": {
          "notice": "Temporary method to check if the allow list has been migrated."
        },
        "setContractSelectorWhitelist(address,bytes4,bool)": {
          "notice": "Sets the whitelist status for a specific contract and selector pair."
        }
      },
      "notice": "Facet contract for managing whitelisted addresses for various protocol interactions.",
      "version": 1
    }
