        },
        "initiateSettlement(bytes32,bytes)": {
          "details": "Initiates a settlement for a batch of orders",
          "params": {
            "orderIDs": "The IDs of the orders to settle",
            "repaymentAddress": "The address to repay the orders to"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "proxiableUUID()": {
          "details": "Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
        },
        "setInterchainSecurityModule(address)": {
          "details": "Updates the interchain security module address",
          "params": {
            "_interchainSecurityModule": "The new interchain security module address"
          }
        },
        "setMailbox(address)": {
          "details": "Updates the Hyperlane mailbox address",
          "params": {
            "_mailbox": "The new mailbox address"
          }
        },
        "setRemoteDomain(uint32,bytes32)": {
          "details": "Sets the remote domain contract for a domain",
          "params": {
            "domain": "The domain to set the remote domain contract for",
            "remoteContract": "The remote domain contract"
          }
        },
        "submitOrder(bytes32,bytes32,uint256,uint256,uint32,uint64,bytes)": {
          "details": "Submits a fast transfer order to the gateway",
          "params": {
            "amountIn": "The amount of tokens the user is sending on the source domain",
            "amountOut": "The amount of tokens the user is receiving on the destination domain",
            "data": "Optional calldata passed on to the recipient on the destination domain when the order is filled",
            "destinationDomain": "The destination domain of the order",
            "recipient": "The recipient of the order on the destination domain",
            "sender": "The sender of the order used in the case of a timeout",
            "timeoutTimestamp": "The deadline that the order must be filled on the destination domain by"
          }
        },
        "submitOrderWithPermit(bytes32,bytes32,uint256,uint256,uint32,uint64,uint256,bytes,bytes)": {
          "details": "Submits a fast transfer order to the gateway with a permit signature",
          "params": {
            "amountIn": "The amount of tokens the user is sending on the source domain",
            "amountOut": "The amount of tokens the user is receiving on the destination domain",
            "data": "Optional calldata passed on to the recipient on the destination domain when the order is filled",
            "destinationDomain": "The destination domain of the order",
            "permitDeadline": "The deadline that the permit is valid for",
            "recipient": "The recipient of the order on the destination domain",
            "sender": "The sender of the order used in the case of a timeout",
            "signature": "The signature of the permit",
            "timeoutTimestamp": "The deadline that the order must be filled on the destination domain by"
          }
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "upgradeToAndCall(address,bytes)": {
          "custom:oz-upgrades-unsafe-allow-reachable": "delegatecall",
          "details": "Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."
        }
      },
      "version": 1
    },
